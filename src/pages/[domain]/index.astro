---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { domainFor, domains, locales } from "../../data/site";
import { questionPages, questionUrl, statusMeta, gitMetaFor } from "../../data/questions";
import { articleThumb, figureCount } from "../../data/thumbs";

export function getStaticPaths() {
  return domains.map((domain) => ({ params: { domain: domain.id } }));
}

const { domain } = Astro.params;
const locale = "en";
const current = domainFor(domain as any)!;
const domainQuestions = questionPages.filter((page) => page.domain === domain);

// Group by readiness so finished pieces aren't mixed in with half-built ones.
// Mirror the Ask page: "Ready to read" vs "Still building" (work-in-progress and
// needs-data both live under the latter, honest rather than hidden).
const statusOrder: Record<string, number> = { ready: 0, work_in_progress: 1, needs_data: 2 };
const sortedQuestions = [...domainQuestions].sort(
  (a, b) =>
    (statusOrder[a.explanation.status] ?? 9) - (statusOrder[b.explanation.status] ?? 9) ||
    a.question.localeCompare(b.question)
);
// Ready pieces, newest first: the most recently published or revised one leads.
const updated = (p: (typeof questionPages)[number]) => gitMetaFor(p.id).updated || p.explanation.lastReviewed || p.explanation.generatedAt || "";
const ready = sortedQuestions.filter((p) => p.explanation.status === "ready").sort((a, b) => String(updated(b)).localeCompare(String(updated(a))));
const building = sortedQuestions.filter((p) => p.explanation.status !== "ready");
const [lead, ...rest] = ready;
const meta = (p: (typeof questionPages)[number]) => {
  const n = figureCount(p);
  return [n ? `${n} ${n === 1 ? "figure" : "figures"}` : "", p.explanation.dataThrough && String(p.explanation.dataThrough).length <= 16 ? `data through ${p.explanation.dataThrough}` : ""].filter(Boolean).join(" · ");
};
const questionGroups = [
  { id: "ready", label: "Ready to read", pages: sortedQuestions.filter((p) => p.explanation.status === "ready") },
  { id: "building", label: "Still building", pages: sortedQuestions.filter((p) => p.explanation.status !== "ready") }
];
const featuredReports = domain === "health"
  ? [
      {
        title: "What NFHS-6 reveals about India",
        dek: "A visual reading of the 2023-24 National Family Health Survey: homes, women, fertility, birth, child health, nutrition, chronic disease, ageing, and care.",
        href: `/health/nfhs-6/`,
        meta: "Special report",
      },
    ]
  : [];
---
<Base title={`${current.label} · This Indian Life`} domain={current.id}>
  <div class="wrap">
    <Nav active={current.id} locale={locale} />

    <header class="domain-head dh">
      <span class="domain-chip"><span class="tk"></span><span>{current.label}</span></span>
      <h1 class="serif">{current.line}</h1>
      <p class="dh-dek">{ready.length} {ready.length === 1 ? "explainer" : "explainers"}{building.length ? `, and ${building.length} still being built` : ""}. Every chart comes with its data and its source.</p>
    </header>

    {featuredReports.length > 0 && (
      <section class="dp-report">
        {featuredReports.map((report) => (
          <a href={report.href}>
            <span class="dp-tag">{report.meta}</span>
            <span class="dp-q">{report.title}</span>
            <span class="dp-dek">{report.dek}</span>
          </a>
        ))}
      </section>
    )}

    {lead && (
      <section class="dp-lead">
        <a href={questionUrl(lead, locale)}>
          <span class="dp-lead-text">
            <span class="dp-tag">Latest</span>
            <span class="dp-q dp-q-lead">{lead.question}</span>
            <span class="dp-dek">{lead.explanation.short?.dek}</span>
            <span class="dp-meta">{meta(lead)}</span>
          </span>
          {articleThumb(lead, [560, 220]) ? <span class="dp-thumb dp-thumb-lead" set:html={articleThumb(lead, [560, 220])} /> : null}
        </a>
      </section>
    )}

    {rest.length > 0 && (
      <section class="dp-grid">
        {rest.map((page) => (
          <a class="dp-card" href={questionUrl(page, locale)}>
            {articleThumb(page) ? <span class="dp-thumb" set:html={articleThumb(page)} /> : null}
            <span class="dp-q">{page.question}</span>
            <span class="dp-dek">{page.explanation.short?.dek}</span>
            <span class="dp-meta">{meta(page)}</span>
          </a>
        ))}
      </section>
    )}

    {building.length > 0 && (
      <section class="dp-building">
        <p class="lbl">Still being built</p>
        <ul>
          {building.map((page) => (
            <li><a href={questionUrl(page, locale)}><span>{page.question}</span><span class="dp-status">{statusMeta(page.explanation.status).short}</span></a></li>
          ))}
        </ul>
      </section>
    )}

    <Footer locale={locale} />
  </div>
</Base>

<style>
  /* Domain page: the newest explainer leads with its own figure, the rest sit in a grid
     of cards (picture, question, one-line dek, figure count), work in progress last. */
  .dh h1{max-width:18ch}
  .dh-dek{font-family:var(--sans);font-size:.95rem;color:var(--mid);margin-top:16px;max-width:60ch}
  .dp-tag{display:block;font-family:var(--sans);font-size:.72rem;letter-spacing:.09em;text-transform:uppercase;font-weight:600;color:var(--c-ink)}
  .dp-q{display:block;font-family:var(--serif);font-weight:500;font-size:1.32rem;line-height:1.22;color:var(--ink);text-wrap:balance}
  .dp-dek{display:block;font-family:var(--serif);font-size:1.02rem;line-height:1.5;color:#3a3a3a;text-wrap:pretty}
  .dp-card .dp-dek{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
  .dp-meta{display:block;font-family:var(--sans);font-size:.78rem;color:var(--dim);font-variant-numeric:tabular-nums}
  .dp-thumb{display:block}
  .dp-thumb :global(svg){display:block;width:100%;height:auto;overflow:visible}
  a:hover .dp-q{color:var(--c-ink)}
  .dp-report,.dp-lead{margin-top:56px;border-top:2px solid var(--ink);padding-top:18px}
  .dp-report a,.dp-lead a{text-decoration:none;color:inherit;display:grid;gap:10px}
  .dp-report a{max-width:760px}
  .dp-lead a{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:56px;align-items:center}
  .dp-lead-text{display:grid;gap:12px}
  .dp-q-lead{font-size:clamp(1.8rem,3.2vw,2.5rem);line-height:1.1;font-weight:400;letter-spacing:-.01em}
  .dp-lead .dp-dek{font-size:1.18rem}
  .dp-grid{margin-top:64px;border-top:1px solid var(--ink);padding-top:28px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:48px 44px}
  .dp-card{display:grid;align-content:start;gap:10px;text-decoration:none;color:inherit}
  .dp-card .dp-thumb{margin-bottom:6px}
  .dp-building{margin-top:72px;border-top:1px solid var(--ink);padding-top:14px}
  .dp-building ul{list-style:none;margin-top:14px}
  .dp-building a{display:flex;justify-content:space-between;align-items:baseline;gap:24px;padding:11px 0;border-top:1px solid var(--line);text-decoration:none;color:var(--ink);font-family:var(--serif);font-size:1.1rem}
  .dp-building a:hover span:first-child{color:var(--c-ink)}
  .dp-status{font-family:var(--sans);font-size:.78rem;color:var(--dim);white-space:nowrap}
  @media(max-width:980px){.dp-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:680px){
    .dp-lead a{grid-template-columns:1fr;gap:20px}
    .dp-thumb-lead{order:-1}
    .dp-grid{grid-template-columns:1fr;gap:40px}
    .dp-card{grid-template-columns:minmax(0,1fr) 96px;column-gap:18px;row-gap:8px}
    .dp-card .dp-thumb{grid-column:2;grid-row:1;margin:4px 0 0;align-self:start}
    .dp-card .dp-q{grid-column:1;grid-row:1;font-size:1.18rem}
    .dp-card .dp-dek,.dp-card .dp-meta{grid-column:1/-1}
    .dp-card .dp-dek{font-size:.98rem;-webkit-line-clamp:3}
  }
</style>

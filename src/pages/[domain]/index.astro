---
// A chapter: its name, what it is about, its defining record from first year to latest,
// the lead question with its figure, up to three more with theirs, then every other
// question in the chapter with its answer.
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import KitPlot from "../../components/kit/KitPlot.astro";
import { domains, type DomainId } from "../../data/site";
import { chapters, CHAPTER_FIGS, emblem, entry, inWords, RECORDS } from "../../data/book";

export function getStaticPaths() {
  return domains.map((domain) => ({ params: { domain: domain.id } }));
}

const id = Astro.params.domain as DomainId;
const chapter = chapters.find((c) => c.id === id)!;
const figs = CHAPTER_FIGS[id];
const record = RECORDS[id];
const lead = entry(figs.lead.q);
const shown = new Set([figs.lead.q, ...figs.band.map((f) => f.q)]);
const rest = chapter.entries.filter((e) => !shown.has(e.page.id));
const cap = (s: string) => s.replace(/^./, (c) => c.toUpperCase());
const counts = chapter.answered === chapter.entries.length
  ? `${cap(inWords(chapter.entries.length))} questions, all answered`
  : `${cap(inWords(chapter.entries.length))} questions, ${inWords(chapter.answered)} answered`;
const report = id === "health"
  ? { title: "What NFHS-6 reveals about India", dek: "A visual reading of the 2023–24 National Family Health Survey: homes, women, fertility, birth, child health, nutrition, chronic disease, ageing and care.", href: "/health/nfhs-6/" }
  : null;
---

<Base title={`${chapter.label} · This Indian Life`} description={chapter.line} domain={id}>
  <div class="wrap">
    <Nav active={id} />

    <section style="padding-top:64px">
      <div class="tl-opn">
        <div>
          <p class="tl-mv" style="margin:0;font-size:20px;line-height:1;color:var(--k-ink3)">Chapter {chapter.ordinal}</p>
          <h1>{chapter.label}</h1>
        </div>
        <div style="padding-bottom:6px">
          <p class="tl-st">{figs.statement}</p>
          <p style="margin:20px 0 0;font:400 13.5px/1.4 var(--k-sans);color:var(--k-ink3)">{counts}</p>
        </div>
      </div>
      <div class="tl-em" style="margin-top:56px" role="img" aria-label={`${record.series}: ${record.start.value} ${record.start.note}, ${record.end.value} ${record.end.note}`} set:html={emblem(record.spec, 1184, 96)} />
      <div class="tl-ends"><span><b>{record.start.value}</b><i>{record.start.note}</i></span><span class="e"><b>{record.end.value}</b><i>{record.end.note}</i></span></div>
    </section>

    <section style="padding-top:112px">
      <div class="tl-dr" aria-hidden="true"></div>
      <div class="tl-grid" style="padding-top:18px">
        <div>
          <p class="tl-k">Question {lead.n}</p>
          <h2 class="tl-q" style="margin:16px 0 0;font:400 44px/1.06 var(--k-display);letter-spacing:-.026em;text-wrap:balance"><a href={lead.href}>{lead.page.question}</a></h2>
          <p class="tl-ans" style="margin-top:26px">{figs.lead.text}</p>
          <p style="margin:22px 0 0;font:400 14.5px/1 var(--k-sans)"><a class="tl-ul" href={lead.href}>Read the answer</a></p>
        </div>
        <figure class="tl-fig">
          <figcaption style="padding-top:0"><span><span class="tl-ft">{figs.lead.title}</span><span class="tl-fd">{figs.lead.dek}</span></span><span class="tl-fn">Fig. 1</span></figcaption>
          <div class="tl-plot"><KitPlot spec={figs.lead.spec} id={figs.lead.id} title={figs.lead.title!} dek={figs.lead.dek} source={figs.lead.source} width={780} /></div>
          <footer class="tl-fs"><span>Source: {figs.lead.source}</span></footer>
        </figure>
      </div>
    </section>

    {figs.band.length ? (
      <section style="padding-top:136px">
        <div class="tl-band">
          {figs.band.map((f) => { const e = entry(f.q); return (
            <article>
              <div><div class="tl-dr" aria-hidden="true"></div><p class="tl-k" style="margin-top:14px;font-weight:400;color:var(--k-ink3)">Question {e.n}</p></div>
              <h3 class="tl-q"><a href={e.href}>{e.page.question}</a></h3>
              <p class="ab">{f.text}</p>
              <div class="tl-plot"><KitPlot spec={f.spec} id={f.id} title={e.page.question} source={f.source} width={368} /></div>
              <footer class="tl-fs"><span>Source: {f.source}</span></footer>
            </article>
          ); })}
        </div>
      </section>
    ) : null}

    {report ? (
      <section style="padding-top:128px">
        <div class="tl-dr" aria-hidden="true"></div>
        <div class="tl-grid" style="padding-top:18px">
          <p class="tl-mv" style="margin:0;font-size:20px;color:var(--k-ink3)">A special report</p>
          <div>
            <h2 class="tl-q" style="margin:0;font:400 36px/1.1 var(--k-display);letter-spacing:-.02em"><a href={report.href}>{report.title}</a></h2>
            <p class="tl-ans" style="margin-top:14px;max-width:640px">{report.dek}</p>
          </div>
        </div>
      </section>
    ) : null}

    {rest.length ? (
      <section style="padding-top:128px">
        <div class="tl-grid">
          <div class="tl-sh"><h2 style="margin:0;font:400 30px/1.1 var(--k-display);letter-spacing:-.02em">Also in this chapter</h2></div>
          <ol class="tl-rows">
            {rest.map((e) => (
              <li class={e.answered ? undefined : "wip"}>
                <span class="no">{String(e.n).padStart(2, "0")}</span>
                <a class="qq" href={e.href}>{e.page.question}</a>
                <span class="a">{e.answer ? <><b>{e.answer.value}</b><i>{e.answer.note}</i></> : <i>{e.state || "answered"}</i>}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    ) : null}

    <Footer />
  </div>
</Base>

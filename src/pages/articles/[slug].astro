---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import ArticleFlow from "../../components/ArticleFlow.astro";
import ConceptPrimer from "../../components/ConceptPrimer.astro";
import EditorialStory from "../../components/EditorialStory.astro";
import ArticleEditLog from "../../components/ArticleEditLog.astro";
import ArticleEvidence from "../../components/ArticleEvidence.astro";
import ArticleCite from "../../components/ArticleCite.astro";
import Footer from "../../components/Footer.astro";
import { domains, locales } from "../../data/site";
import { annotateStorySections, keyGlossaryTerms, macchaExplanation, markdownBlocks, pullQuoteForPage, questionPages, questionUrl, readableBlocks, statusMeta } from "../../data/questions";
import { visualsForQuestion, bindSectionVisuals, bindSectionVisualGroups } from "../../data/viz";
import { articleGraph, SITE } from "../../data/seo";

export function getStaticPaths() {
  return questionPages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const locale = "en";
const { page } = Astro.props;
const explanation = page.explanation;
const related = questionPages.filter((item) => item.id !== page.id && item.domain === page.domain).slice(0, 4);
// Long paragraphs are broken where the thought turns; the words are untouched.
const blocks = readableBlocks(markdownBlocks(explanation.article.bodyMarkdown));
const updatedLabel = explanation.generatedAt
  ? new Date(explanation.generatedAt).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : null;
const status = statusMeta(explanation.status);
// Curated plan decides which charts show and at what size. The page reads as a
// narrative: an opening answer + hero chart, then prose sections each interleaved
// with the chart they discuss. The lead (core indicator) chart opens the story.
const visuals = visualsForQuestion(page);
// Bind ALL charts to sections via the map (including the hero) so the section that
// maps to the lead chart actually receives it. Sizing (hero/feature/small) is carried
// on each visual, so the lead still renders large in its section.
const storyVisuals = visuals;
const maccha = macchaExplanation(page);
// The "tell me what this means, bro" block: prefer the LLM-written version, fall
// back to the template. It now lives AFTER the data, where the question naturally arises.
const llmMacha = (explanation as { macha?: { heading?: string; body?: string; soWhat?: string } }).macha;
const machaBlock = llmMacha?.heading
  ? { heading: llmMacha.heading, body: llmMacha.body || "", soWhat: llmMacha.soWhat || "" }
  : { heading: maccha.title, body: maccha.body, soWhat: maccha.bullets?.[0] || "" };
const pullQuote = pullQuoteForPage(page);
const editorialStory = explanation.editorialStory;

type MarkdownBlock = ReturnType<typeof markdownBlocks>[number];
const storySections: Array<{ heading: string; blocks: MarkdownBlock[] }> = [];
let currentSection: { heading: string; blocks: MarkdownBlock[] } | null = null;
for (const block of blocks) {
  if (block.type === "h2") {
    if (currentSection) storySections.push(currentSection);
    currentSection = { heading: block.text, blocks: [] };
  } else if (currentSection) {
    currentSection.blocks.push(block);
  } else {
    currentSection = { heading: explanation.article.title, blocks: [block] };
  }
}
if (currentSection) storySections.push(currentSection);

// Pair each prose section with the chart it discusses. The LLM's sectionVisualMap
// (heading -> visualId) wins; otherwise a token-overlap heuristic. Unbound charts
// fall to a compact grid at the end so nothing high-signal is dropped.
const sectionInputs = storySections.map((section) => ({
  heading: section.heading,
  text: section.blocks.filter((block) => block.type === "p").map((block) => block.text).join(" ")
}));
type SectionVisualEntry = { heading: string; visualId?: string; visualIds?: string[] };
const sectionVisualEntries = ((explanation as { sectionVisualMap?: SectionVisualEntry[] }).sectionVisualMap || []);
const groupedExplicitMap = Object.fromEntries(
  sectionVisualEntries
    .filter((entry) => Array.isArray(entry.visualIds))
    .map((entry) => [entry.heading, entry.visualIds || []])
);
const hasGroupedMap = Object.keys(groupedExplicitMap).length > 0;
const explicitMap = Object.fromEntries(
  sectionVisualEntries
    .filter((entry) => entry.visualId)
    .map((entry) => [entry.heading, entry.visualId as string])
);
const groupedBinding = hasGroupedMap
  ? bindSectionVisualGroups(sectionInputs, storyVisuals, groupedExplicitMap)
  : null;
const singleBinding = hasGroupedMap
  ? null
  : bindSectionVisuals(sectionInputs, storyVisuals, explicitMap);
const boundVisualGroups = groupedBinding?.bound || singleBinding!.bound.map((visual) => visual ? [visual] : []);
const leftoverVisuals = groupedBinding?.leftover || singleBinding!.leftover;
const visualStartIndexes: number[] = [];
let visualCursor = 0;
for (const group of boundVisualGroups) {
  visualStartIndexes.push(visualCursor);
  visualCursor += group.length;
}
const chartLabel = (index: number) => {
  const count = boundVisualGroups[index]?.length || 0;
  const start = visualStartIndexes[index] + 1;
  return count > 1 ? `Charts ${start}-${start + count - 1}` : `Chart ${start}`;
};

// Inline glossary: define jargon where the reader meets it. Every glossary term
// gets a tappable popover on first mention; the load-bearing terms (named in the
// headline/dek) get an inline definition box instead. Chart-binding above still
// uses the original storySections, so this only changes how prose renders.
const glossaryBlocks = explanation.editorialPlan?.glossaryBlocks ?? [];
const keyTerms = keyGlossaryTerms(glossaryBlocks, `${explanation.short.headline} ${explanation.short.dek}`);
const annotatedSections = annotateStorySections(storySections, glossaryBlocks, keyTerms);
// Section anchors for the contents rail. The first section repeats the story title when
// the prose opens before its first heading; that heading is dropped, not listed twice.
const sectionIds = annotatedSections.map((section, index) => `s${index + 1}-${section.heading.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 48)}`);

// The lead figure (the plan's hero) opens the page, above the first words, and leaves its section.
let hero: { visual: any; start: number } | null = null;
const groups = boundVisualGroups.map((group) => [...group]);
const starts = [...visualStartIndexes];
groups.forEach((group, gi) => {
  const k = group.findIndex((visual) => (visual as { size?: string }).size === "hero");
  if (!hero && k >= 0) { hero = { visual: group[k], start: starts[gi] + k }; group.splice(k, 1); starts[gi] += k === 0 ? 1 : 0; }
});
// Two figures the plan pairs (`pairWith` names the partner) sit side by side where the second falls.
for (const entry of (page.visualPlan || []) as Array<{ title?: string; pairWith?: string }>) {
  if (!entry.title || !entry.pairWith) continue;
  const where = (title: string) => { for (let gi = 0; gi < groups.length; gi += 1) { const k = groups[gi].findIndex((v) => v.title === title); if (k >= 0) return [gi, k]; } return null; };
  const b = where(entry.title), a = where(entry.pairWith);
  if (!a || !b) continue;
  const [visualA] = groups[a[0]].splice(a[1], 1);
  const bb = where(entry.title)!;
  groups[bb[0]].splice(bb[1], 0, visualA);
  (visualA as { pairRole?: string }).pairRole = "a";
  (groups[bb[0]][bb[1] + 1] as { pairRole?: string }).pairRole = "b";
}
// The figures beside the opening: the registry's own, or the article's one point.
const keyNumbers = page.keyNumbers?.length
  ? page.keyNumbers
  : !(pullQuote as { generic?: boolean }).generic ? [{ value: String(pullQuote.stat).replace(/,$/, ""), label: pullQuote.line, hot: false }] : [];
const reviewed = explanation.lastReviewed && /^\d{4}-\d{2}-\d{2}$/.test(explanation.lastReviewed)
  ? new Date(`${explanation.lastReviewed}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
  : explanation.lastReviewed;
const flowProps = {
  title: explanation.article.title,
  sections: annotatedSections,
  sectionIds,
  groups,
  starts,
  hero,
  leftover: leftoverVisuals,
  leftoverStart: visualCursor,
  lockedNumbers: explanation.evidence.lockedNumbers,
  chartExplainers: explanation.chartExplainers,
  parts: page.parts,
  keyNumbers,
  machaBlock,
  concepts: explanation.editorialPlan?.glossaryBlocks ?? []
};
---

<Base title={`${page.question} · This Indian Life`} description={explanation.short.dek} domain={page.domain} ogType="article" image={`/og/articles/${page.slug}.png`} jsonLd={articleGraph(page, locale)} markdownUrl={`/articles/${page.slug}.md`}>
  <div class={`wrap${page.slug === "india-and-gold" ? " theme-gold" : ""}${page.slug === "how-is-climate-change-changing-india" ? " theme-climate-canonical" : ""}${page.slug === "why-the-rupee-falls" ? " theme-rupee" : ""}${page.slug === "when-does-india-actually-turn-the-power-on" ? " theme-grid" : ""}${page.id === "q.econ.income_classification" ? " theme-income-classification" : ""}`}>
    <Nav active={page.domain} locale={locale} />

    <header class="ar-head">
      <p class="ar-kicker">{domains.find((d) => d.id === page.domain)?.label ?? page.domain}{status.cls !== "ready" ? <span class={`head-status ${status.cls}`}>{status.label}</span> : null}</p>
      <h1 class="serif">{page.question}</h1>
      <p class="ar-dek">{explanation.short.dek}</p>
      <p class="ar-byline">
        <span>By <a href={SITE.author.url} rel="author">{SITE.author.name}</a></span>
        {reviewed
          ? <span>Reviewed {reviewed}</span>
          : (updatedLabel ? <span>Updated {updatedLabel}</span> : null)}
        {explanation.dataThrough ? <span>Data through {explanation.dataThrough}</span> : null}
      </p>
    </header>

    {editorialStory ? (
      <nav class="article-tabs article-tabs--views" aria-label="Article views" data-article-tablist>
        <button class="article-tab is-active" data-article-tab="data" type="button" aria-selected="true">Article</button>
        <button class="article-tab" data-article-tab="essay" type="button" aria-selected="false">Essay</button>
        <button class="article-tab" data-article-tab="evidence" type="button" aria-selected="false">Evidence</button>
      </nav>
    ) : null}

    {page.primer ? <ConceptPrimer primer={page.primer} domain={page.domain} /> : null}

    {editorialStory ? (
      <>
        <section class="article-panel" data-article-panel="data">
          <section class="ar" id="charts"><ArticleFlow {...flowProps} /></section>
        </section>

        <section class="article-panel article-panel-story" data-article-panel="essay" hidden>
          <EditorialStory story={editorialStory} lockedNumbers={explanation.evidence.lockedNumbers} />
        </section>

        <section class="article-panel" data-article-panel="evidence" hidden>
          <section class="section article-meta-section" id="evidence">
            <ArticleEvidence explanation={explanation} />
          </section>
        </section>

        <script is:inline>
          (() => {
            const tablist = document.querySelector("[data-article-tablist]");
            if (!tablist) return;
            const tabs = Array.from(document.querySelectorAll("[data-article-tab]"));
            const panels = Array.from(document.querySelectorAll("[data-article-panel]"));
            const valid = new Set(panels.map((panel) => panel.getAttribute("data-article-panel")));
            function show(id, updateUrl = true, scroll = true) {
              const target = valid.has(id) ? id : "data";
              panels.forEach((panel) => {
                panel.hidden = panel.getAttribute("data-article-panel") !== target;
              });
              tabs.forEach((tab) => {
                const active = tab.getAttribute("data-article-tab") === target;
                tab.classList.toggle("is-active", active);
                tab.setAttribute("aria-selected", active ? "true" : "false");
              });
              if (updateUrl) {
                const url = new URL(window.location.href);
                if (target === "data") url.searchParams.delete("view");
                else url.searchParams.set("view", target);
                history.replaceState(null, "", url);
              }
              if (scroll) {
                if (target === "data") window.scrollTo({ top: 0, behavior: "smooth" });
                else tablist.scrollIntoView({ block: "start", behavior: "smooth" });
              }
            }
            tabs.forEach((tab) => {
              tab.addEventListener("click", () => show(tab.getAttribute("data-article-tab")));
            });
            const initial = new URL(window.location.href).searchParams.get("view");
            show(initial && valid.has(initial) ? initial : "data", false, false);
          })();
        </script>
      </>
    ) : (
      <>
        <section class="ar" id="charts"><ArticleFlow {...flowProps} /></section>

        <section class="section article-meta-section" id="evidence">
          <ArticleEvidence explanation={explanation} />
        </section>
      </>
    )}

    <section class="section article-cite-section" id="cite">
      <ArticleCite page={page} explanation={explanation} />
    </section>

    <section class="section article-related">
      <p class="sec-hd">Keep reading</p>
      {related.map((item) => (
        <a class="q-row" href={questionUrl(item, locale)}>
          <span class="q-dot" style={`background:var(--${item.domain})`}></span>
          <span class="q-txt">{item.question}</span>
          <span class="q-arrow">-></span>
        </a>
      ))}
    </section>

    <ArticleEditLog questionId={page.id} explanation={explanation} />

    <Footer locale={locale} />
    <script src="/article-actions.js" defer></script>
  </div>
  <script>
    // Contents rail: mark the section being read, the last heading above the top third of
    // the screen. Read on scroll (one frame at a time), so a jump or a link lands right too.
    (() => {
      const links = Array.from(document.querySelectorAll(".story-rail a"));
      if (!links.length) return;
      const targets = links.map((a) => document.getElementById(a.getAttribute("href").slice(1)));
      let current = null, queued = false;
      const update = () => {
        queued = false;
        const line = window.innerHeight * 0.3;
        let k = 0;
        targets.forEach((t, i) => { if (t && t.getBoundingClientRect().top <= line) k = i; });
        const next = links[k];
        if (next === current) return;
        if (current) current.removeAttribute("aria-current");
        next.setAttribute("aria-current", "true");
        current = next;
        const box = next.closest(".story-rail-in");
        if (box) { const r = next.getBoundingClientRect(), br = box.getBoundingClientRect(); if (r.top < br.top || r.bottom > br.bottom) box.scrollTop += r.top - br.top - br.height / 3; }
      };
      const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      update();
    })();
    // Inline glossary terms: tap to toggle the definition popover (touch), with
    // keyboard support; CSS handles hover/focus on pointer devices.
    (() => {
      const closeAll = (except) => document.querySelectorAll('.defterm[aria-expanded="true"]')
        .forEach((el) => { if (el !== except) el.setAttribute("aria-expanded", "false"); });
      document.addEventListener("click", (e) => {
        const term = (e.target instanceof Element) ? e.target.closest(".defterm") : null;
        closeAll(term);
        if (term) {
          const open = term.getAttribute("aria-expanded") === "true";
          term.setAttribute("aria-expanded", open ? "false" : "true");
          e.preventDefault();
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") return closeAll(null);
        const el = document.activeElement;
        if (el && el.classList && el.classList.contains("defterm") && (e.key === "Enter" || e.key === " ")) {
          const open = el.getAttribute("aria-expanded") === "true";
          el.setAttribute("aria-expanded", open ? "false" : "true");
          e.preventDefault();
        }
      });
    })();
  </script>
</Base>

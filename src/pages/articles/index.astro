---
// The contents: every question in six chapters, numbered, each with the answer it gives.
// The search box filters the list as you type; the words it searches are baked in.
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { chapters, emblem, inWords, RECORDS, totals } from "../../data/book";

const searchText = (e: (typeof chapters)[number]["entries"][number], chapter: string) =>
  [e.page.question, e.page.explanation.short?.headline, e.page.explanation.short?.dek, chapter, e.answer?.value, e.answer?.note,
    ...(e.page.explanation.editorialPlan?.glossaryBlocks?.map((g) => g.term) ?? [])]
    .filter(Boolean).join(" ").toLowerCase();
const cap = (s: string) => s.replace(/^./, (c) => c.toUpperCase());
---

<Base title="Contents · This Indian Life" description={`${cap(inWords(totals.all))} questions about India in six chapters, each answered from official data with the table it came from.`}>
  <div class="wrap">
    <Nav active="articles" />

    <section class="tl-grid" style="padding-top:72px">
      <div><h1 style="margin:0;font:300 104px/.9 var(--k-display);letter-spacing:-.05em" class="tl-h-c">Contents</h1></div>
      <div style="padding-top:10px">
        <p class="tl-st">{cap(inWords(totals.all))} questions about India in six chapters. {cap(inWords(totals.answered))} are answered, each with the number that settles it and the table it came from.</p>
        <div class="tl-find" id="find"><label for="find-q">Find a question</label><input id="find-q" type="search" placeholder="fertility, rupee, heat…" autocomplete="off" /></div>
        <p style="margin:18px 0 0;font:400 14px/1.8 var(--k-sans)">
          {chapters.map((c, i) => <>{i ? " · " : ""}<a href={`#${c.id}`} style="color:var(--k-ink);text-decoration:none">{c.label}</a> <span style="color:var(--k-ink3)">{c.entries.length}</span></>)}
        </p>
        <p id="find-none" hidden class="tl-mv" style="margin:24px 0 0;font-size:18px">No question matches that yet.</p>
      </div>
    </section>

    {chapters.map((c) => (
      <section style="padding-top:96px" id={c.id} data-chapter>
        <div class="tl-dr" aria-hidden="true"></div>
        <div class="tl-grid" style="padding-top:22px">
          <div>
            <p class="tl-mv" style="margin:0;font-size:18px;color:var(--k-ink3)">Chapter {c.ordinal}</p>
            <h2 style="margin:12px 0 0;font:300 64px/1 var(--k-display);letter-spacing:-.04em"><a href={`/${c.id}/`} style="color:inherit;text-decoration:none">{c.label}</a></h2>
            <p style="margin:16px 0 0;max-width:300px;font:400 14.5px/1.45 var(--k-sans);color:var(--k-ink2)">{c.line}</p>
            <div class="tl-em" style="margin-top:28px;max-width:200px" aria-hidden="true" set:html={emblem(RECORDS[c.id].spec, 200, 40)} />
            <p style="margin:12px 0 0;font:400 13px/1 var(--k-sans);color:var(--k-ink3)">{c.answered} answered{c.answered === c.entries.length ? "" : `, ${c.entries.length - c.answered} under way`}</p>
          </div>
          <ol class="tl-rows">
            {c.entries.map((e) => (
              <li class={e.answered ? undefined : "wip"} data-s={searchText(e, c.label)}>
                <span class="no">{String(e.n).padStart(2, "0")}</span>
                <a class="qq" href={e.href}>{e.page.question}</a>
                <span class="a">{e.answer ? <><b>{e.answer.value}</b><i>{e.answer.note}</i></> : <i>{e.state || "answered"}</i>}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    ))}

    <Footer />
  </div>
  <script is:inline>
    (() => {
      const input = document.getElementById("find-q"), none = document.getElementById("find-none");
      const rows = [...document.querySelectorAll("[data-s]")], groups = [...document.querySelectorAll("[data-chapter]")];
      const run = () => {
        const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
        let shown = 0;
        rows.forEach((r) => { const hit = terms.every((t) => r.dataset.s.includes(t)); r.hidden = !hit; if (hit) shown++; });
        groups.forEach((g) => { g.hidden = !g.querySelector("[data-s]:not([hidden])"); });
        none.hidden = shown > 0;
      };
      input.addEventListener("input", run);
      if (location.hash === "#find") input.focus();
    })();
  </script>
</Base>

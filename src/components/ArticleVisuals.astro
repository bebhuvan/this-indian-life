// Series order: the domain ink, then ink black, then the three named data inks the
// domain does not already use (set per domain as --s3..--s5 in indica.css), then grey.
// A seventh series folds into a light grey rather than inventing a hue, and so does every
// series after it: cycling back to the domain ink would give two lines the same colour.
const colors = ["var(--c)", "var(--s2)", "var(--s3)", "var(--s4)", "var(--s5)", "var(--s6)", "#b3b3b3"];

/** The ink of every line in a chart. Fixed meanings win over the palette and over colours
 *  hard-coded in the registry: rural is always hara, urban always neel. When two lines
 *  share a meaning ("Rural, with imputation" and "Rural, without"), the second is dashed.
 *  The other lines take the palette in order, skipping inks a fixed meaning has used. */
function lineInks(lines: Array<{ label: string; color?: string; dash?: boolean }>) {
  const fixed = (label: string) => (/\brural\b/i.test(label) ? "#008a6e" : /\burban\b/i.test(label) ? "#33489a" : null);
  const anyFixed = lines.some((l) => fixed(l.label));
  const seen = new Set<string>();
  let k = 0;
  // With rural/urban present, the domain ink could repeat hara or neel, so the others start at ink black.
  const rest = anyFixed ? ["#121212", "#b98014", "#7b4790", "#c24a2e", "#8a8a8a", "#b3b3b3"] : colors;
  // India among other countries always wears the domain ink, as it does when it is listed
  // first, so its colour holds from chart to chart within an article: when it sits later in
  // the plan it trades inks with the first line. Registry colours still win.
  const ix = anyFixed ? -1 : lines.findIndex((l) => /^india$/i.test(String(l.label).trim()));
  const swap = ix > 0 && !lines[ix].color && !lines[0].color;
  const order = (i: number) => (swap && i === ix ? 0 : swap && i === 0 ? ix : i);
  return lines.map((l, i) => {
    const f = fixed(l.label);
    if (f) { const dash = seen.has(f) || !!l.dash; seen.add(f); return { color: f, dash }; }
    if (!anyFixed) return { color: l.color ?? colors[Math.min(order(i), colors.length - 1)], dash: !!l.dash };
    return { color: rest[Math.min(k++, rest.length - 1)], dash: !!l.dash };
  });
}

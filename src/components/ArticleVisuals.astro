function viewBoxSize(viewBox: string) {
  const parts = viewBox.trim().split(/\s+/).map(Number);
  return {
    width: parts[2] && Number.isFinite(parts[2]) ? parts[2] : 740,
    height: parts[3] && Number.isFinite(parts[3]) ? parts[3] : 820
  };
}

function axisTextAnchor(x: number, width: number, pad: { l: number; r: number }, labelW = 0) {
  // A centred label that would run past either edge of the figure is anchored to it.
  if (x <= pad.l + 1 || x - labelW / 2 < 0) return "start";
  if (labelW && x + labelW / 2 > width) return "end";
  // Anchor "end" near the right edge so a centred label can't overflow the viewBox. The
  // last time-tick often lands ~1-2px INSIDE the plot edge and so missed the pad.r-based
  // threshold by a hair — staying "middle"-anchored and clipping (e.g. "2026" 4px past).
  if (x >= width - pad.r - 1 || x >= width - 24) return "end";
  return "middle";
}

function shortAxisLabel(label: string) {
  return label
    .replace("Districts at high or very high heat risk", "More high-risk districts ->")
    .replace("Households without AC/cooler protection proxy", "Less household cooling ->");
}

function scatterTick(value: number, label: string) {
  const lower = label.toLowerCase();
  if (label.includes("%") || lower.includes("percent")) return `${Math.round(value)}%`;
  if (lower.includes("year") || lower.includes("station") || lower.includes("file")) return `${Math.round(value)}`;
  return Math.abs(value) < 10 ? value.toFixed(1) : `${Math.round(value)}`;
}

function scatterValue(value: number, label: string) {
  const lower = label.toLowerCase();
  if (label.includes("%") || lower.includes("percent")) return `${Number(value.toFixed(1))}%`;
  if (lower.includes("year") || lower.includes("station") || lower.includes("file")) return `${Math.round(value)}`;
  return Number(value.toFixed(1)).toLocaleString("en-IN");
}


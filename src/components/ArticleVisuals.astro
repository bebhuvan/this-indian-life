function shortLabel(label: string) {
  const dimensions = label.match(/\(([^)]+)\)/)?.[1]
    .split(",")
    .map((item) => item.trim())
    .filter((item) => item && !/not applicable/i.test(item));
  const cleaned = label
    .replace(/: value$/i, "")
    .replace(/: NumericValue$/i, "")
    .replace(/ by sex/i, "")
    .replace(/\s+\([^)]*\)/g, "")
    .replace(/, latest/i, "")
    .replace(/, earliest/i, "");
  return dimensions?.length ? `${cleaned} · ${dimensions.join(" · ")}` : cleaned;
}

function kpiLabel(item: LockedNumber) {
  const raw = item.label.toLowerCase();
  const dims = item.label.match(/\(([^)]+)\)/)?.[1]
    .split(",")
    .map((part) => part.trim())
    .filter((part) => part && !/not applicable/i.test(part)) || [];
  const sex = dims.find((part) => /both sexes|male|female/i.test(part));
  const variant = dims.find((part) => /median|high|low|constant|zero/i.test(part));
  if (raw.includes("population")) {
    if (/high/i.test(variant || "")) return "High-fertility scenario";
    if (/low/i.test(variant || "")) return "Low-fertility scenario";
    if (/male/i.test(sex || "") && !/female/i.test(sex || "")) return "Men";
    if (/female/i.test(sex || "")) return "Women";
    if (/latest/i.test(raw)) return "Latest population estimate";
    if (/earliest/i.test(raw)) return "Earliest population estimate";
    return "Projected population";
  }
  if (/latest/i.test(raw)) return `Latest ${shortLabel(item.label).toLowerCase()}`;
  if (/earliest/i.test(raw)) return `Earliest ${shortLabel(item.label).toLowerCase()}`;
  return shortLabel(item.label);
}

function kpisToShow(items: LockedNumber[]) {
  const preferred = [
    "econ.idh.nominal_gdp_annual",
    "econ.idh.per_capita_nominal_gdp",
    "econ.idh.real_gdp_annual",
    "econ.idh.gva_services_nominal",
    "econ.idh.private_consumption_nominal"
  ];
  const latest = items.filter((item) => /latest/i.test(item.label));
  const pool = latest.length ? latest : items;
  const seen = new Set<string>();
  return [...pool]
    .sort((a, b) => {
      const ai = preferred.indexOf(a.indicatorId);
      const bi = preferred.indexOf(b.indicatorId);
      if (ai !== -1 || bi !== -1) return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
      return 0;
    })
    .filter((item) => {
      if (seen.has(item.indicatorId)) return false;
      seen.add(item.indicatorId);
      return true;
    })
    .slice(0, 5);
}

function valueParts(item: LockedNumber) {
  const formatted = formatLockedNumber(item);
  const value = /rupees|inr|₹/i.test(item.unit) && !formatted.includes("₹") ? fmt(item.value, item.unit) : formatted;
  const match = value.match(/^(.+?)\s+(crore|lakh|million|billion|trillion)$/i);
  if (!match) return { number: value, unit: "" };
  return { number: match[1], unit: match[2] };
}

function kpiValue(item: LockedNumber) {
  return fmt(item.value, item.unit);
}


const MONTH_ABBR = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

function formatAxisLabel(date: string) {
  if (/^\d{4}-\d{2}$/.test(String(date))) return String(date);
  const match = String(date).match(/^(\d{4})(?:-(\d{2})-\d{2})?/);
  if (!match) return date;
  return match[1];
}

function compactPeriodLabel(date: string) {
  const match = String(date).match(/^(\d{4})-(\d{2})$/);
  if (!match) return String(date);
  const month = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][Number(match[2]) - 1];
  return month ? `${month} ${match[1]}` : String(date);
}

/** How a single point's date is written beside it. Annual series dated 31 March are
 *  financial years ("2025-26"); other annual series are years; monthly ones "Mar 2026". */
function pointDateLabel(date: string, points: Array<{ date: string }>) {
  const d = String(date);
  if (isFySeries(points.map((q) => String(q.date)))) return /^\d{4}-\d{2}$/.test(d) ? d : fyLabel(fyStartOf(d));
  const m = d.match(/^(\d{4})(?:-(\d{2}))?(?:-(\d{2}))?$/);
  if (!m) return d.slice(0, 10);
  const tails = new Set(points.map((q) => String(q.date).slice(4)));
  const years = points.map((q) => Number(String(q.date).slice(0, 4)));
  const annual = tails.size === 1 && years.every((y, i) => i === 0 || y - years[i - 1] >= 1);
  if (!m[2] || annual) {
    if (annual && m[2] === "03" && m[3] === "31") return `${Number(m[1]) - 1}-${m[1].slice(2)}`;
    return m[1];
  }
  const days = new Set(points.map((q) => String(q.date).slice(8)));
  // A monthly series stamped at month end (30 Apr, 31 May, 28 Feb) has many distinct days
  // but is still monthly: "Apr 2013", not "30 Apr 2013". Judged by the typical gap.
  const t = points.map((q) => Date.parse(String(q.date).slice(0, 10))).filter(Number.isFinite).sort((a, b) => a - b);
  const gaps = t.slice(1).map((v, i) => (v - t[i]) / 864e5).sort((a, b) => a - b);
  const monthly = gaps.length > 0 && gaps[Math.floor(gaps.length / 2)] >= 27;
  if (m[3] && days.size > 2 && !monthly) return `${Number(m[3])} ${compactPeriodLabel(`${m[1]}-${m[2]}`)}`;
  return compactPeriodLabel(`${m[1]}-${m[2]}`);
}

function svgCoord(value: number, precision = 1) {
  return Number(value.toFixed(precision)).toString();
}

function cardClass(visualIndex: number, visual: VisualSpec, leadFirst = true) {
  // Explicit plan size wins over heuristics: hero = full+large, feature = full, small = grid cell.
  const size = (visual as { size?: string }).size;
  if (size === "hero") return "viz-card viz-main";
  if (size === "feature") return "viz-card viz-wide";
  if (size === "small") return "viz-card";
  if (leadFirst && visualIndex === 0) return "viz-card viz-main";
  if (visual.kind === "change") return "viz-card viz-wide";
  if (visual.kind === "line" && visual.lines.length > 1) return "viz-card viz-wide";
  if (visual.kind === "linePanels") return "viz-card viz-wide";
  if (visual.kind === "groupedBar") return "viz-card viz-wide";
  if (visual.kind === "bar" && visual.title.toLowerCase().includes("trade flows")) return "viz-card viz-wide";
  if (visual.kind === "bar" && visual.title.toLowerCase().includes("change by decade")) return "viz-card viz-wide";
  if (visual.kind === "bar" && visual.bars.length > 8) return "viz-card viz-wide";
  if (visual.kind === "pyramid" || visual.kind === "stack") return "viz-card viz-wide";
  if (visual.kind === "stripes") return "viz-card viz-wide";
  if (visual.kind === "choropleth" || visual.kind === "scatter" || visual.kind === "scatterXY" || visual.kind === "scenarioMaps" || visual.kind === "sparkGrid" || visual.kind === "rankedChange") return "viz-card viz-wide";
  return "viz-card";
}

function sourceName(sourceId: string) {
  if (sourceNames[sourceId]) return sourceNames[sourceId];
  // Unknown ids print as words, short ones as acronyms: "foo-bar" -> "FOO Bar".
  return String(sourceId).replace(/-derived$/, "").split(/[-_]/).filter(Boolean)
    .map((part) => (part.length <= 4 ? part.toUpperCase() : part.charAt(0).toUpperCase() + part.slice(1))).join(" ");
}

function sourceLabel(source: VisualSpec["source"]) {
  // Our World in Data ids carry the grapher slug before "::" and the column's own name after
  // it ("share-richest-1-wid-vs-pip::Share according to the World Inequality Database").
  const id = String(source.sourceIndicatorId || "").replace(/^[a-z0-9-]+::(?=\S)/, "");
  // The media/news article's internal indicator ids (e.g. "media.news.iamai_news_users_2024")
  // are not reader-facing; the chart subtitle carries the dataset detail, so show only the
  // clean source name. Scoped to "media." ids so other articles are unaffected.
  if (/^media\./.test(id) || id === "broadband_subscribers_total") return sourceName(source.sourceId);
  // Many artifacts set sourceIndicatorId to our own internal indicatorId, which then printed
  // as a reader-facing byline: "unctad · extfin.fdi.dev.gfcf_share.IND.pct", "plfs · lfpr_male".
  // Upstream codes worth showing carry uppercase (SL.AGR.EMPL.ZS, DGS10, EXFIDIP*11A) and human
  // descriptors carry spaces; both survive this. Only all-lowercase dotted or underscored
  // internal ids are dropped, leaving the source name and the chart subtitle to do the work.
  // Upstream dotted codes are all-uppercase segments (SL.AGR.EMPL.ZS, SP.DYN.LE00.IN) and are
  // worth printing. Ours mix in lowercase segments (extfin.fdi.dev.gfcf_share.IND.pct,
  // macro.current_account_usd) and are not. Human descriptors contain spaces and are kept.
  const looksInternal = !/\s/.test(id) && (
    (id.includes(".") && id.split(".").some((seg) => seg && seg === seg.toLowerCase() && /[a-z]/.test(seg))) ||
    /^[a-z0-9]+_[a-z0-9_]+$/.test(id) || isMachineId(id)
  );
  if (looksInternal) return sourceName(source.sourceId);
  if (source.sourceId === "ppac") {
    if (id === "international-prices-crude-oil.indian-basket.$-per-bbl") return "PPAC · Indian crude basket price · $/bbl";
    if (id.startsWith("import-export:2025-2026:reportBy:1")) return "PPAC · Import/export of crude oil and petroleum products, quantity · 2025-26";
    if (id.startsWith("import-export:2025-2026:reportBy:2")) return "PPAC · Import/export of crude oil and petroleum products, value in rupees · 2025-26";
    if (id.startsWith("import-export:2025-2026:reportBy:3")) return "PPAC · Import/export of crude oil and petroleum products, value in dollars · 2025-26";
    if (id.includes("NG-C-LNG-Import")) return "PPAC · LNG imports, quantity and value · 2025-26";
    return `PPAC · ${id}`;
  }
  if (source.sourceId === "tradestat") {
    const history = id.match(/^(\d+)\.imports\.partner-history\.(\d{4})-(\d{4})$/);
    if (history) return `TradeStat / DGCI&S · HS ${history[1]} imports by partner · ${history[2]}-${String(Number(history[2]) + 1).slice(-2)} to ${history[3]}-${String(Number(history[3]) + 1).slice(-2)}`;
    const hs = id.match(/^(\d+)\.imports\.(\d{4})$/);
    if (hs) return `TradeStat / DGCI&S · HS ${hs[1]} imports by partner · ${hs[2]}-${String(Number(hs[2]) + 1).slice(-2)}`;
    return `TradeStat / DGCI&S · ${id}`;
  }
  if (source.sourceId === "ember") {
    if (id === "electricity-generation/yearly") return "Ember · Yearly electricity generation by source";
    if (id === "electricity-demand/yearly") return "Ember · Yearly electricity demand";
    if (id === "carbon-intensity/yearly") return "Ember · Yearly electricity carbon intensity";
  }
  if (source.sourceId === "worldbank") {
    if (id === "EG.ELC.ACCS.ZS") return "World Bank · Access to electricity (% of population)";
    if (id === "SP.POP.TOTL") return "World Bank · Population, total";
  }
  if (source.sourceId === "india-energy-derived") {
    if (id === "ppac-and-tradestat.fuel-import-spend.2025-2026") return "PPAC + TradeStat / DGCI&S · Fuel import spend · 2025-26";
  }
  // Never print the source twice ("RBI e-STATES · RBI e-STATES").
  const nm = sourceName(source.sourceId).trim();
  if (id && id.trim().toLowerCase().startsWith(nm.toLowerCase())) return id.trim();
  return id ? `${sourceName(source.sourceId)} · ${id}` : sourceName(source.sourceId);
}

/** Ids that mean something to the pipeline and nothing to a reader: dataset keys with
 *  colons ("mendeley:y58jknpgs8:summer2024"), snake_case field names ("peak_gw",
 *  "2m_temperature state warming" keeps its words), camelCase keys and bare numbers. */
function isMachineId(seg: string) {
  const s = seg.trim();
  if (!s || /\s/.test(s)) return false;
  // Dotted keys with lowercase hyphenated segments ("international-prices-crude-oil.indian-basket.$-per-bbl").
  if (/\./.test(s) && /[a-z]-[a-z]/.test(s)) return true;
  return /:/.test(s) || /^\d+$/.test(s) || /_/.test(s) || /^[a-z]+[A-Z][A-Za-z]*(:\w+)?$/.test(s) || /^derived:/.test(s);
}

function cleanSubtitle(value: string, sourceId: string) {
  return value
    .replace(sourceId, sourceName(sourceId))
    .replace(" · value", "")
    .replace(" · NumericValue", "")
    .split(" · ")
    // Upstream codes (SP.POP.TOTL, NY.GDP.PCAP.CD) belong in the source line, not the subtitle.
    // So do database series keys: IndiaDataHub's "IFTLDATPSB11Q", EIA's "47-33-IND-MBTUPP.annual".
    .filter((seg) => !isMachineId(seg) && !/^[A-Z0-9]+(\.[A-Z0-9]+){1,}$/.test(seg.trim())
      && !(/^[A-Z0-9]{8,}$/.test(seg.trim()) && /\d/.test(seg) && /[A-Z]{3}/.test(seg))
      && !/^\d+-\d+-[A-Z]{2,}/.test(seg.trim())
      // and dataset slugs: "annual-temperature-anomalies", "imd-pune-southwest-monsoon-all-india-rainfall"
      && !/^[a-z0-9]+(-[a-z0-9]+){2,}$/.test(seg.trim()))
    // Variable names inside a phrase read as words: ERA5's "2m_temperature broad-region annual
    // anomaly" is air temperature by broad region.
    .map((seg) => seg
      .replace(/\b2m_temperature\b/g, "air temperature").replace(/\btotal_precipitation\b/g, "rainfall")
      .replace(/\bmonsoon_share_pct\b/g, "monsoon share of the year's rain, %").replace(/\bbroad-region\b/g, "by broad region")
      .replace(/\b([a-z]+)_([a-z_]+)\b/g, (m) => m.replace(/_/g, " "))
      .replace(/^ERA5 hourly /, "hourly "))
    .join(" · ");
}

function insightForVisual(visual: VisualSpec) {
  const title = visual.title.toLowerCase();
  if (title.includes("latest gva by sector")) return "This is the production-side split. It shows whether the economy is mainly agriculture, industry, or services at the latest point.";
  if (title.includes("what gdp is made of")) return "This is the spending-side split. Household consumption, investment, government consumption, and net exports are different ways GDP gets counted.";
  if (title.includes("trade flows") || title.includes("imports and exports")) return "Each year has two bars: exports and imports. When the import bar is taller, net exports are negative and subtract from GDP.";
  if (title.includes("nominal gdp")) return "This is the headline size of the economy in current rupees. It includes both real growth and price changes, so read it as the money value of output.";
  if (title.includes("real gdp")) return "This removes the effect of inflation using 2011-12 prices. Use it when the question is growth in actual output, not just bigger rupee numbers.";
  if (title.includes("per capita")) return "This divides the economy by the population. It is closer to the average-person question than total GDP, but it still says nothing about distribution.";
  if (title.includes("gva") && title.includes("agriculture")) return "Agriculture supports a large share of livelihoods, but its output share is much smaller than services or industry. That gap is the structural story.";
  if (title.includes("gva") && title.includes("industry")) return "Industry is the production base: factories, construction, mining, utilities. Watch whether it is expanding fast enough to absorb workers productively.";
  if (title.includes("gva") && title.includes("services")) return "Services are the largest block of the economy. A services-heavy economy can grow fast, but the jobs question has to be asked separately.";
  if (title.includes("private final consumption")) return "This is household spending. If this line is large, the economy is being pulled heavily by what people buy.";
  if (title.includes("gross capital formation")) return "This is the investment line: buildings, machines, infrastructure, and inventories. It matters because today's investment shapes tomorrow's capacity.";
  if (title.includes("government final consumption")) return "This is government spending on current services, not all public investment. It is one part of the state footprint in GDP.";
  if (title.includes("net exports")) return "Positive means exports exceed imports. Negative means imports are larger, so domestic demand is partly being met from abroad.";
  if (title.includes("population, total")) return "Read the headline chart as the scale of the whole country. Every later percentage on this page sits on top of this denominator.";
  if (title.includes("scenario spread")) return "The variants are close, but the gap still represents crores of people. Projection uncertainty is small as a percentage and large in human terms.";
  if (title.includes("crude rate")) return "The slope is the key: India is still growing, but the annual pace of addition is slowing.";
  if (title.includes("median age")) return "Median age moves slowly, which is why this rising line matters. It shows the population becoming older even while India remains young overall.";
  if (title.includes("broad age")) return "This is the quick dependency picture: children, working-age people, and older adults as shares of the total.";
  if (title.includes("pyramid")) return "The widest bands show where demographic pressure sits today. A rectangular shape would mean an older, slower-growing population.";
  if (title.includes("5-year age")) return "This is the granular version of the age story. It shows which cohorts are largest instead of compressing everyone into three buckets.";
  if (title.includes("by sex")) return "The male and female lines move together, but their gap is visible. Use this with the pyramid for the age-specific picture.";
  if (title.includes("change by decade") && /people|population/i.test(visual.unit + " " + (visual.subtitle || ""))) return "This breaks the big rise into periods, so the reader can see when the population added more or less in absolute terms.";
  if (title.includes("how much changed") && /people|population/i.test(visual.unit + " " + (visual.subtitle || ""))) return "Read this as the extra population added, not the latest population repeated. The decade chart above shows how that addition was distributed over time.";
  return "Use this chart as one view of the evidence, then read it beside the neighbouring charts before drawing a conclusion.";
}

// The title-matched notes above are specific; the last line of insightForVisual is a
// generic sentence that said nothing about the chart in front of the reader, so a
// chart without an explainer now shows no note rather than boilerplate.
const GENERIC_INSIGHT = "Use this chart as one view of the evidence, then read it beside the neighbouring charts before drawing a conclusion.";
function specificInsight(visual: VisualSpec) {
  const s = insightForVisual(visual);
  return s === GENERIC_INSIGHT ? "" : s;
}

function indicatorIdForVisual(visual: VisualSpec) {
  return visual.source.indicatorId || "";
}

function slugifyTitle(value: string) {
  return String(value).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
}

function explainerForVisual(visual: VisualSpec, index: number) {
  const indicatorId = indicatorIdForVisual(visual);
  const title = visual.title.toLowerCase();
  const slug = slugifyTitle(visual.title);
  const generated = chartExplainers.find((item) =>
    slugifyTitle(item.visualId || "") === slug ||
    (indicatorId && item.visualId?.endsWith(indicatorId)) ||
    item.title?.toLowerCase() === visual.title.toLowerCase() ||
    (item.title && item.title.toLowerCase().includes(visual.title.toLowerCase()))
  );
  if (!generated && title.includes("latest gva by sector")) {
    return {
      index: index + 1,
      title: visual.title,
      whyShowThis: "Total GDP answers the size question. The sector chart answers the next question: what kind of economy creates that output.",
      howToRead: insightForVisual(visual),
      mistakeToAvoid: "Do not read sector output as sector employment. Agriculture can support many workers while forming a smaller share of output.",
      mobileNote: "Use three horizontal bars and short labels."
    };
  }
  if (!generated && title.includes("what gdp is made of")) {
    return {
      index: index + 1,
      title: visual.title,
      whyShowThis: "GDP is not just one giant number. This chart shows the spending pieces behind it.",
      howToRead: insightForVisual(visual),
      mistakeToAvoid: "Do not add this up like a household budget. Net exports can be negative because imports are subtracted in GDP accounting.",
      mobileNote: "Keep the zero line visible because net exports can go below zero."
    };
  }
  if (!generated && title.includes("quarterly")) {
    return {
      index: index + 1,
      title: visual.title,
      whyShowThis: title.includes("nominal")
        ? "The annual number gives scale. The quarterly nominal line shows the latest current-price size within the year."
        : "The annual number gives scale. The quarterly real line shows the more recent movement in inflation-adjusted output.",
      howToRead: insightForVisual(visual),
      mistakeToAvoid: "Do not compare one quarter directly with a full financial year. The units are rupees, but the time periods are different.",
      mobileNote: "Use sparse year ticks and a clear latest-point label."
    };
  }
  if (!generated && (title.includes("trade flows") || title.includes("imports and exports"))) {
    return {
      index: index + 1,
      title: visual.title,
      whyShowThis: "Net exports alone is too compressed. This chart shows the two large flows behind it: what India sells abroad and what it buys from abroad.",
      howToRead: insightForVisual(visual),
      mistakeToAvoid: "Do not read a trade deficit as exports being unimportant. It means imports are larger than exports in value.",
      mobileNote: "Use horizontal bars with a visible zero line for the net export bar."
    };
  }
  // Curated plan note (from the registry visualPlan) is the fallback before the
  // generic boilerplate, so every chart gets a specific reason even before the
  // LLM-generated chartExplainers exist.
  const note = (visual as { note?: { why?: string; detail?: string; read?: string; watch?: string } }).note;
  return {
    index: index + 1,
    title: generated?.title || visual.title,
    // takeaway = the one-line point; detail = a fuller plain-language paragraph.
    takeaway: generated?.takeaway || note?.why || generated?.whyShowThis || "",
    detail: note?.detail || generated?.detail || generated?.whyShowThis || note?.read || specificInsight(visual),
    howToRead: generated?.howToRead || note?.read || specificInsight(visual),
    mistakeToAvoid: generated?.mistakeToAvoid || note?.watch || "",
    // Both of these render, so they fall back to nothing rather than to boilerplate.
    // The old mobileNote fallback ("fewer ticks, short labels") was an instruction to
    // whoever builds the chart, not something a reader should ever have been shown -
    // it only stayed invisible because neither field was wired into the markup.
    // whyShowThis is suppressed when it already supplied takeaway or detail above,
    // so the same sentence never appears twice in one card.
    whyShowThis: generated?.whyShowThis && generated?.takeaway && (note?.detail || generated?.detail) ? generated.whyShowThis : "",
    mobileNote: generated?.mobileNote || ""
  };
}

const chartDownloadBase = `${Astro.url.pathname.replace(/\/$/, "")}/charts`;


function lineGeometry(visual: LineVisual, isLead = false, twoUp = false, bounds?: { min?: number; max?: number }, mobile = false, forceEndLabelPad = false, tightRight = false, keyValues = false): LineGeometry {
  // The viewBox width is matched to how wide the chart actually renders, so one fixed
  // axis-font size reads consistently: 2-up (leftover grid) charts render ~half width
  // and use a narrow box; section-bound charts render full width and use a wide box.
  // Without this, the same font is tiny on half-width charts and garish on full-width ones.
  // On phones every chart renders at ~one column width, so the wide desktop box would shrink
  // to ~0.3x — sub-7px labels, ~130px tall. The `mobile` variant uses a small, near-square
  // box that renders close to 1:1: a taller chart with readable labels (see .viz-m CSS).
  const isHero = (visual as { size?: string }).size === "hero";
  // Two-up cards render about 510 px wide on a desktop: a 660 box set 13-unit axis text at 10 px.
  const width = mobile ? 384 : (twoUp ? (isLead ? 560 : 520) : (isLead ? 1120 : 1000));
  const height = mobile ? (isHero ? 406 : 346) : (isHero ? 560 : isLead ? 500 : 360);
  const yFontSize = mobile ? 12 : 13;
  const padRTB = mobile
    ? { r: 24, t: 22, b: 40 }
    : isLead ? { r: 24, t: 34, b: 48 } : { r: 24, t: 26, b: 46 };
  // Multi-line charts print each line's latest value to the RIGHT of its end point
  // (.end-mini-v, left-anchored at latestX + offset). Desktop has room for the full
  // value+unit; the narrow mobile box shows the bare number (axis carries the unit) so
  // the plot stays wide. Either way, size the right pad to the widest label — the mirror
  // of the dynamic LEFT pad below — so nothing clips off the viewBox.
  const dataMaxAbs = Math.max(1, ...visual.lines.flatMap((l) => l.points.map((p) => Math.abs(p.value))));
  // Phone end values are bare and borrow the axis's scale word, so they are written in the
  // scale of the axis's top tick: data peaking at 999.6 million on an axis to 1.2 billion
  // printed "999.6" under a "billion" caption.
  const endMaxAbs = mobile ? Math.max(dataMaxAbs, Math.abs(tightScale(0, typeof bounds?.max === "number" ? bounds.max : dataMaxAbs).max)) : dataMaxAbs;
  const endText = (value: number) => endLabelInScale(value, endMaxAbs, visual.unit, mobile, mobile);
  // On a phone, five or more lines end in a ladder of unnamed values on leaders, which the
  // key below cannot untangle. With a protagonist (the emphasised line, or India among
  // three or more), only its value is written; the others keep their end dots and tooltips.
  const onlyIdx = mobile && visual.lines.length >= 5 ? protagonistIndex(visual.lines) : -1;
  const quiet = (index: number) => keyValues || (onlyIdx >= 0 && index !== onlyIdx);
  // A line whose data stop a year or more before the others' is named at its own end, inside
  // the plot (renderLineSvg), so it claims no gutter. One rule for the geometry and the render.
  const yearOfDate = (d: unknown) => Number(String(d).slice(0, 4));
  const lastYear = Math.max(...visual.lines.map((l) => yearOfDate(l.points.at(-1)?.date)));
  const stopsShort = (line: LineVisual["lines"][number]) => visual.lines.length > 1 && lastYear - yearOfDate(line.points.at(-1)?.date) >= 1;
  {
    void forceEndLabelPad;
    // Desktop end labels read "Kerala 1.5" (name and value); phones show the value only
    // and name the series in a key below the chart, so the narrow plot stays wide.
    const endOffset = mobile ? 9 : visual.lines.length === 1 ? 10 : 9;
    // A single line's latest value is set as a headline figure, so its gutter is wider.
    const one = visual.lines.length === 1;
    const endFont = mobile ? (one ? 14 : 12) : one ? (isLead ? 19 : 17) : 13.5;
    // The gutter is as wide as the widest label actually printed, measured with the font's own
    // widths (textWidth): a single line's value (and the date under it, in a smaller size), a
    // phone's bare values, or a desktop "Name value" with the name in semibold (bold for the
    // protagonist) and wrapped onto two lines when long.
    const emph = emphasised(visual.lines);
    const dateW = one ? textWidth(pointDateLabel(String(visual.lines[0].points.at(-1)?.date ?? ""), visual.lines[0].points), mobile ? 11.5 : 12) : 0;
    // Measured as printed: the values after harmoniseDecimals, which turned a measured "30%" into
    // a printed "30.0%" and ran the label off the figure.
    const printed = harmoniseDecimals(visual.lines.map((line, index) => {
      const v = line.points.at(-1)?.value;
      return v == null || quiet(index) ? "" : endText(v);
    }));
    // ...and typeset, as the page prints it: a hyphen measured for the minus it becomes ran
    // "−$308.2 billion" 2 px past the figure.
    const tw = (t: string, size: number, wt = 400) => textWidth(typeset(`>${t}<`).slice(1, -1), size, wt);
    const maxLabelW = Math.max(
      dateW,
      ...visual.lines.map((line, index) => {
        const v = line.points.at(-1)?.value, text = printed[index];
        if (v == null || quiet(index) || stopsShort(line)) return 0;
        if (mobile || one) return tw(text, endFont, 600);
        const names = endNameLines(line.label, endText(v)), wt = emph[index] ? 700 : 600;
        return Math.max(...names.slice(0, -1).map((l) => tw(l, endFont, wt)), tw(names.at(-1)!, endFont, wt) + 5 + tw(text, endFont));
      })
    );
    // The gutter is the gap to the label, the label, and a few units so its last glyph clears
    // the edge: no wider, or the plot gives up width to blank paper.
    padRTB.r = Math.max(mobile ? padRTB.r : 12, endOffset + Math.ceil(maxLabelW) + (mobile ? 3 : 1));
    // Trying the values inside the plot: the right gutter only needs room for the end dot.
    if (tightRight) padRTB.r = 12;
  }
  const all = visual.lines.flatMap((line) => line.points);
  const values = all.map((point) => point.value);
  const useLogScale = visual.title.toLowerCase().includes("gdp per person over time")
    || visual.title.toLowerCase().includes("the same starting line")
    || (visual as { logScale?: boolean }).logScale === true;
  const positiveValues = values.filter((value) => value > 0);
  const rawMin = Math.min(...values);
  const rawMax = Math.max(...values);
  const bounded = bounds && (typeof bounds.min === "number" || typeof bounds.max === "number");
  const scaleMin = typeof bounds?.min === "number" ? bounds.min : rawMin;
  const scaleMax = typeof bounds?.max === "number" ? bounds.max : rawMax;
  const logMinRaw = Math.max(1, (Math.min(...positiveValues) || 1) * 0.8);
  const logMaxRaw = Math.max(10, (Math.max(...positiveValues) || 10) * 1.18);
  // Temperature/ratio-like data (range small next to its own values) is not zero-baselined,
  // or the lines compress into a thin band; magnitude data (range >> min, e.g. emissions,
  // population) keeps a 0 floor so area height stays meaningful.
  const tight = !bounded && rawMin > 0 && (rawMax - rawMin) < rawMin;
  const linear = tightScale(scaleMin < 0 ? scaleMin : tight ? scaleMin : 0, scaleMax || 1);
  const min = useLogScale ? Math.log10(logMinRaw) : linear.min;
  const max = useLogScale ? Math.log10(logMaxRaw) : linear.max;
  const span = max - min || 1;
  const logTicks = [100, 1000, 10000, 100000].filter((tick) => tick >= logMinRaw * 0.9 && tick <= logMaxRaw * 1.1);
  const ticks = useLogScale && logTicks.length >= 2 ? logTicks : linear.ticks;
  // Size the left padding to the widest y-axis label so "₹400 lakh cr" / "$10 trillion"
  // don't overflow off the left edge of the viewBox (which clipped the leading digits).
  // On mobile the unit moves to a caption above the axis (unitCaption, rendered in the
  // template) and every tick is a bare number, so the gutter is sized to the bare
  // labels ("₹400") — not the long unit label — which keeps the narrow plot wide.
  const refLabel = axisFmt(ticks[ticks.length - 1], ticks, visual.unit);
  // The unit, once, over the y axis: the scale word on phones ("lakh cr"), or the measure
  // itself ("births per woman") wherever the tick labels are bare numbers.
  const bareTop = /^-?[\d.,]+$/.test(refLabel);
  const unitWord = bareTop ? cleanUnit(visual.unit) : "";
  const unitCaption = mobile ? (yUnitCaption(ticks, visual.unit) || unitWord) : unitWord;
  // Desktop: a y gutter as wide as the widest tick label as printed, plus the gap to the plot.
  // Phone: no gutter. Each y label sits flush left just above its gridline (the FT / Economist
  // layout), so the plot takes the full width; a right-aligned column sized for "1,000" left
  // space beside every shorter label on every phone chart.
  // The widest label starts at the figure's left edge, on the title's edge, and ends 10 units
  // short of the plot.
  const pad = { l: mobile ? 5 : Math.max(16, Math.ceil(Math.max(...ticks.map((tick, ti) => textWidth(typeset(`>${yTickLabel(tick, ti, ticks, visual.unit, mobile)}<`).slice(1, -1), yFontSize)))) + 10), ...padRTB };
  // The unit caption sits in its own row ABOVE the top tick, so give it headroom — without
  // it the caption ("lakh cr") collides with the topmost number ("₹400") at the same corner.
  // On a phone the caption joins the top y label instead ("150 crore"), which already sits
  // above its gridline; a separate row stacked "crore" over "150" in the corner.
  if (unitCaption && !mobile) pad.t += 16;
  const plotW = width - pad.l - pad.r;
  // Position points by real time. Monthly series must use the month too; otherwise all
  // twelve YYYY-MM points in a year collapse onto one x-position and render as steps.
  // Financial-year series ("2017-18", "2018-19"): the second part is the next year, not a
  // month. Read as months they land in December of the first year and the axis misprints.
  const fyMode = isFySeries(visual.lines.flatMap((line) => line.points.map((p) => String(p.date))));
  // An annual series stamped on one day of the year (31 December, 1 July) is a series of
  // years: placed by its month it sat most of a year right of its own year tick, so a series
  // from 1990 opened on a "1991" tick and ended short of the last.
  const allDates = visual.lines.flatMap((line) => line.points.map((p) => String(p.date)));
  const tailSet = new Set(allDates.map((d) => d.slice(4)));
  const annualStamp = !fyMode && tailSet.size === 1 && /^-\d{2}(?:-\d{2})?$/.test([...tailSet][0] ?? "");
  const timeOf = (d: string) => {
    if (fyMode) return fyStartOf(d) + 0.25;
    if (annualStamp) return Number(String(d).slice(0, 4));
    // Accepts YYYY, YYYY-MM, YYYY-MM-DD and YYYY-Qn. Both the quarter and the DAY matter:
    // without the quarter branch all four quarters of a year stacked on one x-position, and
    // without the day every date in a month did the same, so a daily series rendered as one
    // vertical spike per month instead of a line.
    const m = String(d).match(/^(-?\d{3,4})(?:-(?:(\d{2})(?:-(\d{2}))?|[Qq]([1-4])))?/);
    if (!m) return null;
    const year = Number(m[1]);
    const month = m[2] ? Number(m[2]) : m[4] ? (Number(m[4]) - 1) * 3 + 1 : 1;
    const clampedMonth = Math.max(1, Math.min(12, month));
    let time = year + (clampedMonth - 1) / 12;
    if (m[3]) {
      const daysInMonth = new Date(Date.UTC(year, clampedMonth, 0)).getUTCDate();
      const day = Math.max(1, Math.min(daysInMonth, Number(m[3])));
      time += ((day - 1) / daysInMonth) / 12;
    }
    return time;
  };
  const inks = lineInks(visual.lines);
  const totalPoints = visual.lines.reduce((n, l) => n + l.points.length, 0);
  const timesAll = visual.lines.flatMap((line) => line.points.map((p) => timeOf(p.date))).filter((v): v is number => v !== null);
  const dateMode = !visual.categoricalX && timesAll.length === totalPoints && timesAll.length > 0 && Math.max(...timesAll) > Math.min(...timesAll);
  const minTime = dateMode ? Math.min(...timesAll) : 0;
  const maxTime = dateMode ? Math.max(...timesAll) : 1;
  const xByTime = (time: number) => pad.l + ((time - minTime) / Math.max(1 / 12, maxTime - minTime)) * plotW;
  const xByIndex = (index: number, count: number) => pad.l + (index / Math.max(1, count - 1)) * plotW;
  const px = (point: Point, index: number, count: number) => (dateMode ? xByTime(timeOf(point.date) ?? minTime) : xByIndex(index, count));
  const scaled = (value: number) => useLogScale ? Math.log10(Math.max(1, value)) : value;
  const y = (value: number) => height - pad.b - ((scaled(value) - min) / span) * (height - pad.t - pad.b);
  const pathsRaw = visual.lines.map((line, lineIndex) => {
    const d = line.points.map((point, index) => `${index === 0 ? "M" : "L"}${svgCoord(px(point, index, line.points.length))} ${svgCoord(y(point.value))}`).join("");
    const xFirst = px(line.points[0], 0, line.points.length);
    const xLast = px(line.points[line.points.length - 1], line.points.length - 1, line.points.length);
    const areaD = `${d}L${svgCoord(xLast)} ${svgCoord(height - pad.b)}L${svgCoord(xFirst)} ${svgCoord(height - pad.b)}Z`;
    const latest = line.points.at(-1);
    const latestX = latest ? xLast : 0;
    const latestY = latest ? y(latest.value) : 0;
    // Measured and projected parts of the line: solid up to the last measured point, dashed
    // after it. A line that is projection from end to end is drawn dashed throughout.
    const after = (line as { projectedAfter?: number }).projectedAfter ?? visual.projectedAfter;
    let dSolid = d, dProj = "";
    if (after !== undefined && dateMode) {
      const k = line.points.reduce((last, point, index) => ((timeOf(point.date) ?? -Infinity) < after + 1 ? index : last), -1);
      const seg = (from: number, to: number) => line.points.slice(from, to + 1).map((point, index) => `${index === 0 ? "M" : "L"}${svgCoord(px(point, from + index, line.points.length))} ${svgCoord(y(point.value))}`).join("");
      if (k < 0) [dSolid, dProj] = ["", d];
      else if (k < line.points.length - 1) [dSolid, dProj] = [k > 0 ? seg(0, k) : "", seg(k, line.points.length - 1)];
      // A jagged model run (year-to-year noise) breaks a dash pattern into specks. Such a line
      // stays solid; the shaded projection zone behind it carries the distinction instead.
      const tail = line.points.slice(Math.max(0, k));
      const turns = tail.slice(2).filter((point, index) => Math.sign(point.value - tail[index + 1].value) * Math.sign(tail[index + 1].value - tail[index].value) < 0).length;
      if (dProj && tail.length > 12 && turns / tail.length > 0.25) [dSolid, dProj] = [d, ""];
    }
    const endLabelText = latest && !quiet(lineIndex) ? endText(latest.value) : "";
    const nameLines = mobile || visual.lines.length === 1 ? [line.label] : endNameLines(line.label, endLabelText);
    return { ...line, d, dSolid, dProj, areaD, latest, latestX, latestY, endLabelText, nameLines, quiet: quiet(lineIndex), short: stopsShort(line), color: inks[lineIndex].color, dash: inks[lineIndex].dash };
  });
  const minGap = mobile ? 15 : 18;
  // A wrapped name runs down from its first baseline, so the label under it starts lower.
  const extra = (index: number) => ((pathsRaw[index].nameLines?.length ?? 1) - 1) * 15;
  const labelTop = pad.t + 14;
  const labelBottom = height - pad.b - 10;
  const sorted = pathsRaw
    .map((path, index) => ({ index, y: path.latestY }))
    .filter((item) => !pathsRaw[item.index].quiet)
    .sort((a, b) => a.y - b.y);
  const need = (i: number) => minGap + extra(sorted[i - 1].index);
  for (let i = 1; i < sorted.length; i += 1) {
    if (sorted[i].y - sorted[i - 1].y < need(i)) sorted[i].y = sorted[i - 1].y + need(i);
  }
  const overflow = sorted.at(-1) ? sorted.at(-1)!.y + extra(sorted.at(-1)!.index) - labelBottom : 0;
  if (overflow > 0) {
    for (const item of sorted) item.y -= overflow;
  }
  for (let i = sorted.length - 2; i >= 0; i -= 1) {
    if (sorted[i + 1].y - sorted[i].y < need(i + 1)) sorted[i].y = sorted[i + 1].y - need(i + 1);
  }
  for (const item of sorted) item.y = Math.max(labelTop, Math.min(labelBottom - extra(item.index), item.y));
  // Clamping to the top can squeeze labels back together; space them again from the top.
  for (let i = 1; i < sorted.length; i += 1) {
    if (sorted[i].y - sorted[i - 1].y < need(i)) sorted[i].y = sorted[i - 1].y + need(i);
  }
  const labelY = new Map(sorted.map((item) => [item.index, item.y]));
  const endLabels = harmoniseDecimals(pathsRaw.map((path) => path.endLabelText));
  const paths = pathsRaw.map((path, index) => ({ ...path, endLabelRaw: path.endLabelText, endLabelText: endLabels[index], labelY: labelY.get(index) || path.latestY }));
  const tickCount = mobile ? 4 : isLead ? 5 : 4;
  let axisTicks: Array<{ xPos: number; label: string }>;
  if (dateMode) {
    const explicitYears = (visual.xTicks || [])
      .filter((year) => Number.isFinite(year) && year >= minTime && year <= maxTime)
      .filter((year, index, arr) => arr.indexOf(year) === index);
    const mobileEndpointTicks = () => {
      const start = Math.ceil(minTime);
      const end = Math.floor(maxTime);
      const maxLabels = Math.max(2, Math.min(5, Math.floor(plotW / 58)));
      if (end <= start) {
        const firstMonth = Math.ceil(minTime * 12 - 1e-9);
        const lastMonth = Math.floor(maxTime * 12 + 1e-9);
        // Whole months only: a fractional step ("2.5 months") indexed past the month names.
        // Months on the calendar step only (Jan, Apr, Jul, Oct): forcing the first and last on as
        // well ran "Jan 24, Apr 24, Jul 24, Dec 24". The end is written under the end value.
        const monthStep = niceMonths((lastMonth - firstMonth) / (maxLabels - 1));
        const months: number[] = [];
        for (let month = Math.ceil(firstMonth / monthStep) * monthStep; month <= lastMonth; month += monthStep) months.push(month);
        if (months.length < 2) months.splice(0, months.length, firstMonth, ...(lastMonth > firstMonth ? [lastMonth] : []));
        return months.map((month) => ({
          xPos: xByTime(month / 12),
          label: `${MONTH_ABBR[month % 12]} ${String(Math.floor(month / 12)).slice(-2)}`
        }));
      }
      // Ticks on round years only (1990, 2000, 2010, 2020), evenly spaced, as on desktop, at the
      // finest round step that fits. Forcing the first and last years on as well gave uneven
      // axes ("2003 2010 2020 2025"); the end year is already written under the end value.
      const roundAt = (step: number) => { const out: number[] = []; for (let year = Math.ceil(start / step) * step; year <= end; year += step) out.push(year); return out; };
      const steps = [1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500];
      const step = steps.find((k) => roundAt(k).length <= maxLabels && roundAt(k).length >= 3);
      if (step) return roundAt(step).map((time) => ({ xPos: xByTime(time), label: String(time) }));
      // A span too short for three round marks steps back evenly from its last year.
      const back = Math.max(1, Math.ceil((end - start) / (maxLabels - 1)));
      const years: number[] = [];
      for (let year = end; year >= start; year -= back) years.unshift(year);
      return years.map((time) => ({ xPos: xByTime(time), label: String(time) }));
    };
    if (visual.monthAxis) {
      // Several calendar years overlaid on one Jan-Dec axis share a pseudo-year, so the
      // tick VALUE is meaningless and only its month position matters. Every other
      // branch here prints Math.round(time), which would render "2000, 2000, 2001".
      const baseYear = Math.floor(minTime);
      const step = mobile ? 3 : 1;
      axisTicks = MONTH_ABBR
        .map((label, i) => ({ i, label, time: baseYear + i / 12 }))
        .filter(({ i, time }) => i % step === 0 && time >= minTime - 1e-9 && time <= maxTime + 1e-9)
        .map(({ label, time }) => ({ xPos: xByTime(time), label }));
    } else if (mobile) {
      axisTicks = mobileEndpointTicks();
    } else if (explicitYears.length) {
      const years = mobile && explicitYears.length > 5
        ? [
            explicitYears[0],
            ...explicitYears.slice(1, -1).filter((year) => year % 10 === 0 && explicitYears.at(-1)! - year > 6),
            explicitYears.at(-1)!
          ].filter((year, index, arr) => arr.indexOf(year) === index)
        : explicitYears;
      axisTicks = years.map((time) => ({ xPos: xByTime(time), label: String(Math.round(time)) }));
    } else {
    // Nice round-year ticks that actually fall INSIDE the data range. niceScale
    // rounds the domain outward, so filtering its ticks to [min,max] can leave
    // just one (a 75-year span snapping to a 50-year step shows only "2000").
      const span = Math.max(1e-6, maxTime - minTime);
      const niceStep = (rough: number) => {
        const mag = 10 ** Math.floor(Math.log10(rough));
        const n = rough / mag;
        return (n < 1.5 ? 1 : n < 3 ? 2 : n < 7 ? 5 : 10) * mag;
      };
      const countIn = (s: number) => { let c = 0; for (let t = Math.ceil(minTime / s) * s; t <= maxTime + 1e-9; t += s) c += 1; return c; };
      // Yearly data never steps by less than a year: a three-year series got "Jan 23, Jul 23".
      const yearly = timesAll.every((t) => Number.isInteger(t));
      let step = niceStep(span / tickCount);
      if (yearly) step = Math.max(1, step);
      while (step > 1 && countIn(step) < 3) step = niceStep(step / 2 - 1e-9);
      const years: number[] = [];
      for (let t = Math.ceil(minTime / step) * step; t <= maxTime + 1e-9; t += step) years.push(t);
      // A sub-annual span (a daily series covering one shock, say) rounds every tick to
      // the same year and renders as "2026" repeated six times, which tells the reader
      // nothing. Below two years, step in months and label them.
      const yearLabels = years.map((time) => String(Math.round(time)));
      if (new Set(yearLabels).size < yearLabels.length) {
        const monthTicks: number[] = [];
        const monthStep = niceMonths(((maxTime - minTime) * 12) / Math.max(1, tickCount - 1));
        const firstMonth = Math.ceil(Math.ceil(minTime * 12 - 1e-9) / monthStep) * monthStep;
        for (let m = firstMonth; m <= maxTime * 12 + 1e-9; m += monthStep) monthTicks.push(m / 12);
        if (monthTicks.length >= 2) {
          axisTicks = monthTicks.map((time) => {
            const year = Math.floor(time + 1e-9);
            const month = Math.round((time - year) * 12);
            return { xPos: xByTime(time), label: `${MONTH_ABBR[Math.max(0, Math.min(11, month))]} ${String(year).slice(-2)}` };
          });
        } else {
          axisTicks = years.map((time) => ({ xPos: xByTime(time), label: String(Math.round(time)) }));
        }
      } else {
        axisTicks = years.map((time) => ({ xPos: xByTime(time), label: String(Math.round(time)) }));
      }
    }
  } else {
    const ap = visual.lines[0]?.points || [];
    // Categorical axis: if the point count is small (survey rounds), show a tick at EVERY
    // point so we never imply unmeasured years between rounds.
    // Otherwise every k-th category from the first, at the smallest whole step that fits: rounded
    // fractions of the count stepped unevenly (Jan, May, Aug, Dec).
    const every = [1, 2, 3, 4, 5, 6, 10, 12, 20, 25, 50].find((k) => Math.ceil(ap.length / k) <= tickCount + 1) ?? Math.ceil(ap.length / tickCount);
    const idxs = visual.categoricalX && ap.length <= 4
      ? ap.map((_, i) => i)
      : ap.map((_, i) => i).filter((i) => i % every === 0);
    axisTicks = idxs
      .filter((v, i, arr) => arr.indexOf(v) === i)
      .filter((i) => ap[i])
      .map((i) => ({ xPos: xByIndex(i, ap.length), label: visual.xLabels?.[i] ?? formatAxisLabel(ap[i].date) }));
  }
  if (fyMode && dateMode && !visual.xTicks?.length) {
    // Ticks on the years themselves, written as financial years, evenly spaced.
    const starts = [...new Set(visual.lines.flatMap((line) => line.points.map((p) => fyStartOf(String(p.date)))))].sort((a, b) => a - b);
    const first = starts[0], lastFy = starts.at(-1)!;
    const fit = Math.max(2, Math.floor(plotW / (mobile ? 84 : 96)) + 1);
    const step = Math.max(1, Math.ceil((lastFy - first) / (fit - 1)));
    // Counted back from the latest year in calendar years, so the ticks are evenly spaced and
    // end on it; counted forward from the first, the last step came up short and its tick was
    // crowded out, and counted in data points, a series with gaps stepped unevenly.
    const picks: number[] = [];
    for (let year = lastFy; year >= first; year -= step) picks.unshift(year);
    axisTicks = picks.map((year) => ({ xPos: xByTime(year + 0.25), label: fyLabel(year) }));
  }
  // Whatever chose the ticks, no two labels may touch: keep the first and the last, and drop
  // any between that would run into a kept neighbour (the last wins over the one before it).
  {
    // Measured against the size the stylesheet actually prints ticks at, with a margin.
    // Each label's real extent: its width as the font sets it, placed by its own anchor (the
    // edge ticks are anchored start and end, so "2023-24" at the right edge runs leftwards
    // into "2022-23"; a centred-label test missed that).
    const axisFont = mobile ? 12.5 : 13, gapMin = mobile ? 14 : 10;
    const span = (t: { xPos: number; label: string }) => {
      const w = textWidth(String(t.label), axisFont), an = axisTextAnchor(t.xPos, width, pad, textWidth(String(t.label), axisFont));
      return an === "start" ? [t.xPos, t.xPos + w] : an === "end" ? [t.xPos - w, t.xPos] : [t.xPos - w / 2, t.xPos + w / 2];
    };
    const clear = (a: { xPos: number; label: string }, b: { xPos: number; label: string }) => span(b)[0] - span(a)[1] >= gapMin;
    // Thinned evenly: every second (third...) tick, counted back from the last, until none
    // touch. Dropping only the tick that collided left gaps of two steps beside gaps of one.
    const sortedTicks = [...axisTicks].sort((a, b) => a.xPos - b.xPos);
    let kept = sortedTicks;
    for (let k = 1; k <= sortedTicks.length; k += 1) {
      kept = sortedTicks.filter((_, i) => (sortedTicks.length - 1 - i) % k === 0);
      if (kept.every((t, i) => i === 0 || clear(kept[i - 1], t))) break;
    }
    axisTicks = kept;
  }
  const geom: LineGeometry = { width, height, pad, ticks, paths, axisTicks, y, xOfTime: xByTime, dateMode, minTime, maxTime, unitCaption, endFont: mobile ? (visual.lines.length === 1 ? 14 : 12) : visual.lines.length === 1 ? (isLead ? 19 : 17) : 13.5 };
  if (!tightRight) {
    // On a phone the right gutter for the end values costs an eighth of the plot. Try the
    // values inside the plot beside each line's end; keep the gutter if any would collide.
    if (mobile) {
      const tight = lineGeometry(visual, isLead, twoUp, bounds, mobile, forceEndLabelPad, true);
      const placed = placeEndLabelsInside(tight, visual.lines.length === 1);
      if (placed) return { ...tight, inside: placed };
    }
    // Labels that had to be pushed off their line ends to clear each other end as a ladder on
    // leaders at the card edge, far from the lines they belong to. They move into the key
    // instead, each value beside its series' name, listed top to bottom as the lines end, and
    // the plot takes back the gutter; the end dots stay. A phone tolerates 9 units of drift, a
    // desktop (whose names sit on leaders) 17 from the middle of the name, under the audit's
    // ladder line of 18 px. Lines that stop early
    // are labelled at their own ends, so they do not count.
    const labelled = geom.paths.filter((p: any) => p.latest && !p.quiet && !p.short);
    // So do the values of lines that stop short when one of them has nowhere clear to be named.
    const earlyFails = visual.lines.length > 1 && !placeEarlyLabels(geom, mobile).clear;
    if (earlyFails || (labelled.length >= 2 && labelled.some((p: any) => (mobile ? Math.abs(p.labelY - p.latestY) > 9 : Math.abs(p.labelY - 4.7 + ((p.nameLines?.length ?? 1) - 1) * 7.5 - p.latestY) > 17)))) {
      const keyed = lineGeometry(visual, isLead, twoUp, bounds, mobile, forceEndLabelPad, true, true);
      const order = geom.paths.map((p: any, i: number) => ({ i, y: p.latest ? p.latestY : Infinity })).sort((a, b) => a.y - b.y).map((o) => o.i);
      return { ...keyed, keyValues: geom.paths.map((p: any) => String((/\.\d{3,}/.test(String(p.endLabelText)) ? p.endLabelRaw : p.endLabelText) || "").replace(/^-/, "−")), keyOrder: order };
    }
  }
  return geom;
}

type LineGeometry = {
  width: number; height: number; pad: { l: number; r: number; t: number; b: number };
  ticks: number[]; paths: Array<any>; axisTicks: Array<{ xPos: number; label: string }>;
  y: (value: number) => number; xOfTime: (time: number) => number; dateMode: boolean;
  minTime: number; maxTime: number; unitCaption: string;
  /** The end label's size, as the gutter was measured for it. */
  endFont: number;
  /** Phone end values set inside the plot: per path, the anchor point and side. */
  inside?: Array<{ x: number; y: number; below: boolean } | null>;
  /** Phone end values moved into the key (per line), and the key's order, top line first. */
  keyValues?: string[]; keyOrder?: number[];
};

/** Every date reads as a financial year: "2017-18" (the second part the following year), or a
 *  year-end stamp of 31 March ("2026-03-31" is FY 2025-26). Read as calendar years, a 31 March
 *  series ran its axis "2010 ... 2025" with the line ending past the last tick. */
function isFySeries(dates: string[]) {
  if (dates.length > 1 && dates.every((d) => /^\d{4}-03-31$/.test(d))) return true;
  return dates.length > 0 && dates.every((d) => {
    const m = d.match(/^(\d{4})-(\d{2})$/);
    return !!m && (Number(m[1]) + 1) % 100 === Number(m[2]);
  });
}
/** The first calendar year of a financial-year date ("2017-18" or "2018-03-31" both give 2017). */
const fyStartOf = (d: string) => (/^\d{4}-03-31$/.test(String(d)) ? Number(String(d).slice(0, 4)) - 1 : Number(String(d).slice(0, 4)));
const fyLabel = (year: number) => `${year}-${String((year + 1) % 100).padStart(2, "0")}`;
/** A month step a calendar reader expects (1, 2, 3, 6 or 12 months, then whole years), at
 *  least `raw`: an 8-month step ran Jan 24, Sep 24, May 25. */
const niceMonths = (raw: number) => [1, 2, 3, 6, 12, 24, 36, 60].find((s) => s >= raw - 1e-9) ?? 12 * Math.ceil(raw / 12);
/** The line a comparison is about: the one the plan emphasises, else India among three or
 *  more lines (renderLineSvg draws the same line heavier). -1 when there is none. */
function protagonistIndex(lines: Array<{ label: string; emphasis?: boolean }>) {
  const e = lines.findIndex((l) => (l as { emphasis?: boolean }).emphasis);
  if (e >= 0) return e;
  return lines.length >= 3 ? lines.findIndex((l) => /^india\b/i.test(String(l.label).trim())) : -1;
}
/** Which lines are drawn emphasised (heavier, names in bold): the plan's, else India among three
 *  or more places; and, beside any emphasised line, every rural or urban line, which is one side
 *  of the comparison, never context (rural India was once a faint hairline beside urban lines).
 *  lineGeometry sizes the labels with it, renderLineSvg draws with it. */
function emphasised(lines: Array<{ label: string; emphasis?: boolean }>) {
  const out = lines.map((l) => Boolean((l as { emphasis?: boolean }).emphasis));
  if (lines.length >= 3 && !out.some(Boolean)) {
    const i = lines.findIndex((l) => /^india\b/i.test(String(l.label).trim()));
    if (i >= 0) out[i] = true;
  }
  if (out.some(Boolean)) lines.forEach((l, i) => { if (/\b(rural|urban)\b/i.test(String(l.label))) out[i] = true; });
  return out;
}
/** A desktop end label's name, on one line when "Name value" is short, else wrapped onto two
 *  lines of about half its length with the value after the last. A long name on one line
 *  ("World Inequality Database method 22.3%") made the right gutter a third of the figure. */
function endNameLines(label: string, value: string) {
  if (label.length + value.length + 1 <= 24) return [label];
  const lines = wrapWords(label, Math.max(14, Math.ceil(label.length / 2) + 2));
  return lines.length <= 2 ? lines : [lines[0], lines.slice(1).join(" ")];
}

/** Places each line's end value just above or below its last point, inside the plot, on the
 *  side the line does not come from. Returns null when any label would touch a line, another
 *  label or the plot edges, so the caller keeps the gutter instead. */
/** Each drawn line as a list of [x, y] vertices, parsed back from its path. */
const linePolys = (g: LineGeometry) => g.paths.map((p: any) => [...String(p.d).matchAll(/[ML](-?[\d.]+) (-?[\d.]+)/g)].map((mm) => [Number(mm[1]), Number(mm[2])]));
/** The y values of a line over an x range (vertices inside it and the ends, interpolated). */
function ysOver(pts: number[][], xa: number, xb: number) {
  const out: number[] = [];
  for (let i = 1; i < pts.length; i += 1) {
    const [x0, y0] = pts[i - 1], [x1, y1] = pts[i];
    if (Math.max(x0, x1) < xa || Math.min(x0, x1) > xb) continue;
    const at = (x: number) => (x1 === x0 ? y0 : y0 + ((x - x0) / (x1 - x0)) * (y1 - y0));
    out.push(at(Math.max(xa, Math.min(x0, x1))), at(Math.min(xb, Math.max(x0, x1))));
  }
  return out;
}
/** Whether a text box [xa, xb] x [top, bot] would touch any drawn line. */
const boxHitsLines = (polys: number[][][], xa: number, xb: number, top: number, bot: number) =>
  polys.some((pts) => ysOver(pts, xa, xb).some((yy) => yy > top - 2 && yy < bot + 2) || (() => {
    // a segment can also pass straight through the box between two sampled ends
    const ys = ysOver(pts, xa, xb);
    return ys.length > 1 && Math.min(...ys) < top && Math.max(...ys) > bot;
  })());

function placeEndLabelsInside(g: LineGeometry, single: boolean) {
  const plotT = g.pad.t, plotB = g.height - g.pad.b, plotL = g.pad.l;
  const polys = linePolys(g);
  const boxes: Array<[number, number, number, number]> = [];
  const result: Array<{ x: number; y: number; below: boolean } | null> = [];
  for (let i = 0; i < g.paths.length; i += 1) {
    const p = g.paths[i];
    if (!p.latest || p.quiet) { result.push(null); continue; }
    const w = String(p.endLabelText).length * (single ? 14 : 12) * 0.6 + 4;
    const h = single ? 30 : 13;
    const xb = p.latestX + 4, xa = xb - w;
    if (xa < plotL + 4) return null;
    // Which side the line arrives from, judged half a label back from its end.
    const back = ysOver(polys[i], xa, xa + w / 2);
    const fromBelow = back.length ? Math.max(...back) > p.latestY : true;
    const sides = fromBelow ? [false, true] : [true, false];
    let done: { x: number; y: number; below: boolean } | null = null;
    // Close beside the point first, then a little further off: a label a few units clear of
    // a line that rises past it still reads as that line's end, the dot ties them.
    for (const gap of [7, 13, 19, 25]) {
      for (const below of sides) {
        const top = below ? p.latestY + gap : p.latestY - gap - h, bot = top + h;
        if (top < plotT - 12 || bot > plotB - 3) continue;
        const hitsLine = boxHitsLines(polys, xa - 2, xb, top - 1, bot + 1);
        const hitsBox = boxes.some(([a, t, b2, bt]) => xa < b2 && xb > a && top < bt + 2 && bot > t - 2);
        // nor any line's end dot (its own included: the label sits beside its dot, not on it)
        const hitsDot = g.paths.some((q: any) => q.latest && q.latestX > xa - 5 && q.latestX < xb + 5 && q.latestY > top - 5 && q.latestY < bot + 5);
        if (!hitsLine && !hitsBox && !hitsDot) { done = { x: xb, y: top, below }; boxes.push([xa, top, xb, bot]); break; }
      }
      if (done) break;
    }
    if (!done) return null;
    result.push(done);
  }
  // The values must stack in the order the lines end: a higher line's value set below a
  // lower one's (13,303 printed above 13,631) misreads, so such a chart keeps the gutter.
  for (let i = 0; i < result.length; i += 1) for (let j = 0; j < result.length; j += 1) {
    const a = result[i], b = result[j];
    if (a && b && g.paths[i].latestY < g.paths[j].latestY - 1 && a.y > b.y) return null;
  }
  return result;
}

/** Names lines that stop short of the others just before their own ends, above or below,
 *  clear of every line, dot and other such label. `clear` is false when any could not be: the
 *  chart then moves its values into the key (lineGeometry) rather than set a name across a line. */
function placeEarlyLabels(g: LineGeometry, m: boolean) {
  const labSize = m ? 12 : 13.5, plotB = g.height - g.pad.b;
  const polys = linePolys(g), boxes: Array<[number, number, number, number]> = [];
  const placed = new Map<any, { xr: number; ly: number }>();
  let clear = true;
  for (const p of g.paths) {
    if (!p.latest || p.quiet || g.inside?.[g.paths.indexOf(p)] || !p.short) continue;
    const text = m ? String(p.endLabelText) : `${(p.nameLines as string[]).join(" ")} ${p.endLabelText}`;
    // Too long to sit left of its end, it starts at the plot's left edge instead: such a line
    // claims no gutter (lineGeometry), so it must stay inside the plot.
    const w = textWidth(text, labSize, 600) + 4, xr = Math.max(p.latestX - 6, g.pad.l + 4 + w);
    const spots = [10, 22, 34].flatMap((k) => [p.latestY - k, p.latestY + k + labSize]).filter((yy) => yy - labSize > g.pad.t && yy < plotB - 2);
    const boxAt = (yy: number): [number, number, number, number] => [xr - w, yy - labSize * 0.85, xr, yy + labSize * 0.25];
    const ok = (yy: number) => {
      const [xa, top, xb, bot] = boxAt(yy);
      return !boxes.some((q) => xa < q[2] && xb > q[0] && top < q[3] + 2 && bot > q[1] - 2)
        && !boxHitsLines(polys, xa, xb, top, bot)
        && !g.paths.some((q: any) => q.latest && q.latestX > xa - 5 && q.latestX < xb + 5 && q.latestY > top - 5 && q.latestY < bot + 5);
    };
    const ly = spots.find(ok);
    if (ly === undefined) { clear = false; continue; }
    boxes.push(boxAt(ly));
    placed.set(p, { xr, ly });
  }
  return { placed, clear };
}

/** The Almanac line chart. Values are written on the lines (no floating headline
 *  number), series are named at their ends in their own ink, gridlines are hairlines,
 *  emphasised series are heavier than context series, and a reference line is named
 *  beside itself. Returns the full <svg> as a string for set:html. */
function renderLineSvg(visual: LineVisual, g: LineGeometry, o: { isLead: boolean; mobile: boolean; chartId: string; cls: string; mention?: string }) {
  const { width, height, pad } = g, m = o.mobile, n = visual.lines.length, single = n === 1;
  const axisSize = m ? 12 : 13, labSize = m ? 12 : 13.5;
  const plotB = height - pad.b, plotR = width - pad.r;
  let b = "";
  // Every label set inside the plot (marks, bands, the reference line) is tested against the
  // lines and the dots and moved, or left to its tooltip, rather than set across a line.
  const polysAll = linePolys(g);
  const dotsAll: Array<[number, number]> = g.paths.flatMap((p: any) => [
    ...(p.latest ? [[p.latestX, p.latestY] as [number, number]] : []),
    ...(single && g.dateMode && p.points.length > 5 ? [[pad.l, g.y(p.points[0].value)] as [number, number]] : []),
  ]);
  const clearAt = (xa: number, xb: number, base: number, size: number) =>
    !boxHitsLines(polysAll, xa, xb, base - size * 0.75, base) && !dotsAll.some(([dx, dy]) => dx > xa - 6 && dx < xb + 6 && dy > base - size - 5 && dy < base + 5);
  let lastBandLabel = -Infinity;
  const bands = lineBandRects(visual, g);
  // A few single-year marks ("1991: India opens up") are drawn as annotations: a hairline at
  // the year and a short label beside it. Many marks (El Nino years) stay as pale shaded bands.
  const asNotes = bands.filter((band) => !band.proj).length <= 3;
  for (const band of bands) {
    // A label shows only if it clears the previous one (measured by its own width).
    // Measured with the font and clamped inside the plot BEFORE the collision test: testing the
    // unclamped centre let two clamped labels meet ("El Nino 1963" on "El Nino 1982").
    const bandSize = m ? 11.5 : 12.5, bw = textWidth(String(band.label || ""), bandSize);
    const bcx = Math.min(plotR - bw / 2, Math.max(pad.l + bw / 2 + 2, band.x + band.w / 2));
    const showLabel = band.label && bcx - bw / 2 > lastBandLabel + 8;
    if (showLabel) lastBandLabel = bcx + bw / 2;
    // Everything after the last measured year sits on a faint ground: the projection zone.
    if (band.proj) b += `<rect x="${svgCoord(band.x + band.w / 2)}" y="${pad.t}" width="${svgCoord(Math.max(0, plotR - band.x - band.w / 2))}" height="${svgCoord(plotB - pad.t)}" fill="#121212" fill-opacity="0.028"/>`;
    if (asNotes || band.proj) {
      // The projection mark reads forward ("projected ->"), so its label sits after the line
      // whenever there is room for it.
      const bx = band.x + band.w / 2, right = band.proj ? plotR - bx < (m ? 72 : 96) : bx > (pad.l + plotR) / 2 + (plotR - pad.l) * 0.25;
      // A single line writes its first value near the top left ("3.35 in 2000"); a mark label
      // that would run into it drops below it.
      const first = single && g.dateMode ? g.paths[0]?.points[0] : undefined;
      const firstNearTop = first && g.y(first.value) < pad.t + 34;
      const ly0 = firstNearTop && (right ? bx - (m ? 72 : 96) : bx) < pad.l + (m ? 110 : 150) ? pad.t + 40 : pad.t + 12;
      b += `<line x1="${svgCoord(bx)}" y1="${pad.t}" x2="${svgCoord(bx)}" y2="${svgCoord(plotB)}" stroke="#121212" stroke-width="0.75" stroke-dasharray="2 3">${band.label ? `<title>${band.label}</title>` : ""}</line>`;
      const fs = m ? 11.5 : 12.5, nx = right ? bx - 6 - bw : bx + 6;
      const ly = [ly0, pad.t + 12, pad.t + 26, pad.t + 40, plotB - 8].find((yy) => clearAt(nx, nx + bw, yy, fs));
      if (showLabel && ly !== undefined) b += almHalo(right ? bx - 6 : bx + 6, ly, band.label!, { size: fs, fill: "#4f4f4f", anchor: right ? "end" : "start" });
      continue;
    }
    b += `<rect x="${svgCoord(band.x)}" y="${pad.t}" width="${svgCoord(band.w)}" height="${svgCoord(plotB - pad.t)}" fill="rgba(194,74,46,0.07)">${band.label ? `<title>${band.label}</title>` : ""}</rect>`;
    // Kept inside the plot: a band near the left edge would otherwise write over the y axis.
    const by = [pad.t + 12, plotB - 6].find((yy) => clearAt(bcx - bw / 2, bcx + bw / 2, yy, bandSize));
    if (showLabel && by !== undefined) b += almTxt(bcx, by, band.label!, { size: bandSize, fill: "#a63d24", anchor: "middle" });
  }
  void asNotes;
  if (g.unitCaption && !m) b += almTxt(2, pad.t - 18, g.unitCaption, { size: m ? 11.5 : 12.5, fill: "#737373" });
  // Gridlines run to the figure's edge, under the end labels, so the values sit inside the
  // chart's frame instead of hanging in a blank margin past the last gridline.
  const yTickBoxes: Array<[number, number, number, number]> = [];
  // Phone y labels are drawn last, over the lines, so a line starting at the left edge never hides one.
  let yLabelsTop = "";
  // A phone y label sits flush left above its gridline unless a line or a dot passes through it
  // there; then it slides right along its own gridline, at most 24 units (further in, a "3" in
  // the middle of the lines read as a stray value, not an axis), and failing that it is left out.
  // The top label carries the unit and stays; the base label (zero, on the heavy line) may slide
  // across the left half, since the heavy line it sits on cannot be mistaken for another. Haloed over the lines, "60" and "$0" were struck
  // through on 230 phone charts.
  const polysY = m ? linePolys(g) : [];
  const dotsY: Array<[number, number]> = m ? g.paths.flatMap((p: any) => [
    ...(p.latest ? [[p.latestX, p.latestY] as [number, number]] : []),
    ...(single && g.dateMode && p.points.length > 5 ? [[pad.l, g.y(p.points[0].value)] as [number, number]] : []),
  ]) : [];
  const yLabelAt = (w: number, base: number, reach = 24) => {
    for (let x = 0; x <= reach; x += 4) {
      if (!boxHitsLines(polysY, x - 1, x + w + 1, base - 9, base) && !dotsY.some(([dx, dy]) => dx > x - 6 && dx < x + w + 6 && dy > base - 15 && dy < base + 5)) return x;
    }
    return null;
  };
  g.ticks.forEach((tick, ti) => {
    const yy = g.y(tick), base = g.ticks.includes(0) ? tick === 0 : ti === 0;
    const label = yTickLabel(tick, ti, g.ticks, visual.unit, m) + (m && g.unitCaption && ti === g.ticks.length - 1 ? ` ${g.unitCaption}` : "");
    b += almLine(m ? 0 : pad.l, yy, width - 2, yy, base ? "#121212" : "#efefef", 1);
    if (m) {
      // Phone: flush left, just above the gridline (see yLabelAt).
      const lw = textWidth(typeset(`>${label}<`).slice(1, -1), 12), top = ti === g.ticks.length - 1;
      const lx = yLabelAt(lw, yy - 5, base ? (width - pad.r) * 0.5 : 24) ?? (top ? 0 : null);
      if (lx === null) return;
      yLabelsTop += `<text class="yaxt" x="${svgCoord(lx)}" y="${svgCoord(yy - 5)}" stroke="#fff" stroke-width="3" stroke-linejoin="round" paint-order="stroke">${label}</text>`;
      yTickBoxes.push([lx, yy - 5 - 10, lx + lw + 3, yy - 2]);
    } else b += `<text class="yaxt" x="${svgCoord(pad.l - 10)}" y="${svgCoord(yy + 4)}" text-anchor="end">${label}</text>`;
  });
  for (const t of g.axisTicks) {
    b += almLine(t.xPos, plotB, t.xPos, plotB + 5, "#121212", 1);
    b += `<text class="xaxt" x="${svgCoord(t.xPos)}" y="${svgCoord(plotB + (m ? 19 : 21))}" text-anchor="${axisTextAnchor(t.xPos, width, pad, textWidth(String(t.label), m ? 12.5 : 13))}">${t.label}</text>`;
  }
  const ref = visual.refLine;
  if (ref) {
    const ry = g.y(ref.value);
    if (ry >= pad.t && ry <= plotB) {
      b += almLine(pad.l, ry, plotR, ry, "#4f4f4f", 0.9, "4 3");
      // Named beside itself at the left, or further along where a line runs through that spot.
      const fs = m ? 11.5 : 12.5, rw = textWidth(ref.label, fs);
      let at: [number, number] | undefined;
      for (let x = pad.l + 8; x + rw <= plotR - 4 && !at; x += 8) {
        const yy = [Math.max(pad.t + 12, ry - 7), ry + 15].find((v) => v < plotB - 2 && clearAt(x, x + rw, v, fs));
        if (yy !== undefined) at = [x, yy];
      }
      if (at) b += almHalo(at[0], at[1], ref.label, { size: fs, fill: "#4f4f4f" });
    }
  }
  // context series first, emphasised series on top
  // In a comparison of three or more places, India is the protagonist unless the plan
  // says otherwise: drawn heavier and on top, the others finer and a little quieter.
  // Each line keeps its own ink, so a colour named in the prose still holds.
  emphasised(g.paths).forEach((e, i) => { if (e) (g.paths[i] as { emphasis?: boolean }).emphasis = true; });
  const order = g.paths.map((p, i) => ({ p, i })).sort((a, z) => Number(Boolean(a.p.emphasis)) - Number(Boolean(z.p.emphasis)));
  const hasEmph = g.paths.some((p) => p.emphasis);
  // A line the card names (in its title, subtitle or takeaway), or the other side of India
  // against one place, is part of the comparison: it keeps full ink and at least 2 units even
  // beside an emphasised line. Faded to context, "Viet Nam's ratio stayed above India's" was
  // told with Viet Nam as a grey hairline.
  const mention = String(o.mention || "").toLowerCase();
  const side = (p: any) => {
    const label = String(p.label).trim().toLowerCase();
    if (n === 2 && g.paths.some((q) => /^india\b/i.test(String(q.label).trim()))) return true;
    return label.length > 1 && new RegExp(`(^|[^\\p{L}])${label.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}([^\\p{L}]|$)`, "u").test(mention);
  };
  for (const { p, i } of order) {
    // 1.75 units is the thinnest line that still draws at 1.5 px when a wide figure is scaled down.
    const named = !single && hasEmph && !p.emphasis && side(p);
    const w = single ? (o.isLead ? 2.5 : 2.2) : p.emphasis ? 3 : named ? 2 : hasEmph ? 1.25 : n > 3 ? 1.75 : 2;
    // A wash under a single series, only when the axis starts at zero so the area means something.
    if (single && g.ticks[0] === 0 && p.points.length > 2) {
      // A flat, quiet tint: it says "this much", where a gradient only decorates.
      b += `<path d="${p.areaD}" fill="${p.color}" fill-opacity="0.07"/>`;
    }
    // Context lines step back (finer, lighter) so the emphasised one reads first; the
    // emphasised line is cased in the ground colour so it lifts cleanly off the lines it crosses.
    const op = !single && hasEmph && !p.emphasis && !named ? ` stroke-opacity="0.6"` : "";
    if (!single && p.emphasis && p.dSolid && !p.dash) b += `<path d="${p.dSolid}" fill="none" stroke="#ffffff" stroke-width="${w + 3}" stroke-linejoin="round" stroke-linecap="round"/>`;
    // A dashed series (a second line with the same fixed meaning) has butt caps and a dash
    // scaled to its weight: round caps on a "4 3" dash closed the gaps, so it read as solid.
    if (p.dSolid) b += `<path d="${p.dSolid}" fill="none" stroke="${p.color}" stroke-width="${w}" stroke-linejoin="round" stroke-linecap="${p.dash ? "butt" : "round"}"${p.dash ? ` stroke-dasharray="${svgCoord(Math.max(5, w * 2.8))} ${svgCoord(Math.max(3, w * 1.6))}"` : ""}${op}><title>${p.label}</title></path>`;
    // The projected part: the same ink and weight, dashed, so it reads as the same series
    // carried forward rather than another one.
    // A dash breaks a line into pieces, so a projected line keeps at least 1.6, and a line that
    // is projected all the way keeps its full ink; thinner and lighter it dissolved into a
    // dotted hairline. One measured in part keeps the opacity of its measured run.
    const wp = Math.max(w, 1.75);
    if (p.dProj) b += `<path d="${p.dProj}" fill="none" stroke="${p.color}" stroke-width="${wp}" stroke-linejoin="round" stroke-linecap="butt" stroke-dasharray="${svgCoord(wp * 2.4)} ${svgCoord(wp * 1.8)}"${p.dSolid ? op : ""}><title>${p.label}, projected</title></path>`;
    void i;
  }
  // End labels for lines that stop short of the right edge, placed before the loop so each
  // can be tested against the others as well as against every line.
  const early = single ? new Map<any, { xr: number; ly: number }>() : placeEarlyLabels(g, m).placed;
  for (const p of g.paths) {
    if (!p.latest) continue;
    b += `<circle cx="${svgCoord(p.latestX)}" cy="${svgCoord(p.latestY)}" r="${single ? (m ? 4 : 4.5) : m ? 3 : 3.5}" fill="${p.color}" stroke="#fff" stroke-width="${m ? 1.5 : 2}"/>`;
    if (p.quiet) continue;
    const inside = g.inside?.[g.paths.indexOf(p)];
    if (single) {
      // the latest value, written beside its point (on a phone, inside the plot when it fits)
      if (inside) {
        b += almHalo(inside.x, inside.y + 12, p.endLabelText, { size: 14, fill: "#121212", weight: 600, anchor: "end" });
        b += almHalo(inside.x, inside.y + 26, pointDateLabel(p.latest.date, p.points), { size: 11.5, fill: "#8a8a8a", anchor: "end" });
      } else {
      const lx = p.latestX + (m ? 8 : 10);
      // The date under the value must stay above the axis: a line ending near the bottom lifts
      // the pair, so "2023-24" never lands on the "2022-23" tick below it.
      const lift = Math.min(0, plotB - 6 - (p.latestY + (m ? 20 : 25)));
      b += almTxt(lx, p.latestY + (m ? 5 : 6) + lift, p.endLabelText, { size: g.endFont, fill: "#121212", weight: 600 });
      b += almTxt(lx, p.latestY + (m ? 20 : 25) + lift, pointDateLabel(p.latest.date, p.points), { size: m ? 11.5 : 12, fill: "#8a8a8a" });
      }
      const first = p.points[0];
      if (first && p.points.length > 5 && g.dateMode) {
        const fx = pad.l + 2, fy = g.y(first.value);
        b += `<circle cx="${svgCoord(pad.l)}" cy="${svgCoord(fy)}" r="${m ? 3 : 3.5}" fill="${p.color}" stroke="#fff" stroke-width="1.5"/>`;
        const maxAbs = Math.max(1e-9, ...p.points.map((q) => Math.abs(q.value)));
        // In the chart's scale unless that would round the first value away ("₹0 lakh"),
        // in which case it is written in its own.
        // Written in its own scale it must carry its scale word even on a phone: bare, "₹710" sat
        // under a "lakh cr" caption for ₹710 crore.
        const ownScale = Math.abs(first.value) / maxAbs < 0.05;
        const firstText = endLabelInScale(first.value, ownScale ? Math.abs(first.value) : maxAbs, visual.unit, m, m && !ownScale);
        // Set the label on the side the line leaves from: under the point when the line rises.
        const ahead = p.points[Math.min(p.points.length - 1, Math.max(3, Math.round(p.points.length / 12)))];
        const rising = ahead && g.y(ahead.value) < fy - 4;
        const firstLabel = `${firstText} in ${pointDateLabel(first.date, p.points)}`, fs = m ? 11.5 : 13;
        // Tried under and over the point, then a step further off, against the line itself:
        // a label set across a steep first stretch ("43 in 1990" over a spike) is unreadable.
        const lw = firstLabel.length * fs * 0.58, polys = linePolys(g);
        const below = (k: number) => fy + 20 + k, above = (k: number) => fy - 10 - k;
        const tries = (rising ? [below(0), above(0), below(10), above(10), below(20), above(20)] : [above(0), below(0), above(10), below(10), above(20), below(20)])
          .filter((yy) => yy - fs > pad.t - 4 && yy < plotB - 4);
        // A dense series with nowhere clear (monthly NREGA spikes) keeps the dot and leaves the
        // value to the tooltip: text laid across a thicket of lines reads as neither.
        const fly = tries.find((yy) => !boxHitsLines(polys, fx + 4, fx + 8 + lw, yy - fs * 0.8, yy + fs * 0.2)
          && !yTickBoxes.some(([a, t, c, d]) => fx + 4 < c && fx + 8 + lw > a && yy - fs * 0.8 < d && yy + fs * 0.2 > t));
        // The starting point is context, the latest is the news: the first value is set
        // lighter and in mid grey so the end label leads.
        if (fly !== undefined) b += almHalo(fx + 6, fly, firstLabel, { size: fs, fill: "#4f4f4f", weight: 500 });
      }
    } else if (inside) {
      b += almHalo(inside.x, inside.y + 10.5, p.endLabelText, { size: labSize, fill: textInk(p.color), weight: 600, anchor: "end" });
    } else if (early.has(p)) {
      // A line that stops well short of the others (observations ending where the projections
      // begin) is named just before its own end, above or below it, clear of every line;
      // set after its end it would sit among the lines that carry on.
      const { xr, ly } = early.get(p)!, names = m ? [] : (p.nameLines as string[]);
      b += m
        ? almHalo(xr, ly, p.endLabelText, { size: labSize, fill: textInk(p.color), weight: 600, anchor: "end" })
        : `<text x="${svgCoord(xr)}" y="${svgCoord(ly)}" text-anchor="end" font-family="Schibsted Grotesk, Helvetica Neue, Arial, sans-serif" font-size="${labSize}" stroke="#fff" stroke-width="4" stroke-linejoin="round" paint-order="stroke"><tspan fill="${textInk(p.color)}" font-weight="${p.emphasis ? 700 : 600}">${names.join(" ")}</tspan><tspan fill="#4f4f4f" dx="5">${p.endLabelText}</tspan></text>`;
    } else {
      const ly = p.labelY, moved = Math.abs(ly - p.latestY) > 3, lx = p.latestX + 9;
      if (moved) b += `<path d="M${svgCoord(p.latestX + 4)} ${svgCoord(p.latestY)}L${svgCoord(lx - 3)} ${svgCoord(ly - 4)}" fill="none" stroke="${p.color}" stroke-width="0.8" stroke-opacity="0.6"/>`;
      b += m
        ? almHalo(lx, ly, p.endLabelText, { size: labSize, fill: textInk(p.color), weight: 600 })
        : `<text x="${svgCoord(lx)}" y="${svgCoord(ly)}" font-family="Schibsted Grotesk, Helvetica Neue, Arial, sans-serif" font-size="${labSize}" stroke="#fff" stroke-width="4" stroke-linejoin="round" paint-order="stroke">${(p.nameLines as string[]).map((name, k) => `<tspan${k ? ` x="${svgCoord(lx)}" dy="15"` : ""} fill="${textInk(p.color)}" font-weight="${p.emphasis ? 700 : 600}">${name}</tspan>`).join("")}<tspan fill="#4f4f4f" dx="5">${p.endLabelText}</tspan></text>`;
    }
  }
  void axisSize;
  // Hover data for the crosshair (article-actions.js): each series' points in viewBox
  // coordinates with a formatted value and date. Parsed back from the drawn path so the
  // hover sits exactly on the line. Long daily series are thinned to about 600 points.
  const hover = {
    plot: [pad.l, pad.t, plotR, plotB],
    series: g.paths.map((p) => {
      const xy = [...p.d.matchAll(/[ML](-?[\d.]+) (-?[\d.]+)/g)].map((mm) => [Number(mm[1]), Number(mm[2])]);
      const maxAbs = Math.max(1e-9, ...p.points.map((q) => Math.abs(q.value)));
      const step = Math.max(1, Math.ceil(p.points.length / 600));
      const pts = p.points.map((q, k) => [xy[k]?.[0] ?? 0, xy[k]?.[1] ?? 0, endLabelInScale(q.value, maxAbs, visual.unit, false, false), String(q.date)]).filter((_, k) => k % step === 0 || k === p.points.length - 1);
      return { label: p.label, color: p.color, pts };
    }),
  };
  const hoverAttr = JSON.stringify(hover).replace(/&/g, "&amp;").replace(/"/g, "&quot;");
  return `<svg class="${o.cls}" viewBox="0 0 ${width} ${height}" role="img" aria-label="${visual.title.replace(/"/g, "&quot;")}" data-hover="${hoverAttr}">${b}${yLabelsTop}</svg>`;
}

/** Shaded event bands (e.g. El Niño years) for a time-axis line chart. Each band is
 *  drawn as a 1-year-wide rectangle centred on its year, clipped to the plot box, so
 *  it only renders where the axis is actually a date axis. */
function lineBandRects(visual: LineVisual, g: LineGeometry) {
  const bands: Array<{ year: number; label?: string; proj?: boolean }> = ((visual as LineVisual & { bands?: Array<{ year: number; label?: string }> }).bands || [])
    .map((b) => ({ ...b, proj: /^projection\b/i.test(b.label || "") }));
  // A chart with a projection gets its mark at the last measured year, unless it names one.
  if (visual.projectedAfter !== undefined && !bands.some((b) => b.proj)) bands.push({ year: visual.projectedAfter, label: "projected ->", proj: true });
  if (!bands.length || !g.dateMode) return [];
  const left = g.pad.l;
  const right = g.width - g.pad.r;
  return bands
    .map((b) => {
      const x0 = Math.max(left, g.xOfTime(b.year - 0.45));
      const x1 = Math.min(right, g.xOfTime(b.year + 0.55));
      return x1 > x0 ? { x: x0, w: x1 - x0, label: b.label, proj: b.proj } : null;
    })
    .filter((r): r is { x: number; w: number; label?: string; proj?: boolean } => Boolean(r));
}

const selectedKpis = kpisToShow(lockedNumbers);
const leftoverGrid = sectionClass.includes("story-leftover");
// In the two-up grid of charts not bound to a section, wide forms (maps, scatters, pyramids,
// stacks) take a full row, drawn at full width: at half width a map was a thumbnail. So does
// the last card of an odd run of half-width ones, which otherwise sat beside a blank half row.
const fullRow = (() => {
  const wide = visuals.map((visual, index) => leftoverGrid && /viz-wide|viz-main/.test(cardClass(index, visual, leadFirst)));
  const out = wide.slice();
  let run: number[] = [];
  const close = () => { if (run.length % 2 === 1) out[run.at(-1)!] = true; run = []; };
  wide.forEach((w, i) => { if (w) close(); else run.push(i); });
  close();
  return leftoverGrid ? out : wide.map(() => false);
})();
const chartNotes = visuals.map((visual, index) => explainerForVisual(visual, index + startIndex));
---

{visuals.length ? (
  <section class={`section viz-section ${sectionClass}`}>
    <div class="layers-top">
      <span class="lbl">{sectionLabel}</span>
    </div>
    {showKpis && selectedKpis.length ? (
      <div class="visual-kpis">
        {selectedKpis.map((item) => {
          return (
            <div class="visual-kpi">
              <span><strong>{kpiValue(item)}</strong></span>
              <p><b>{kpiLabel(item)}</b>{item.date ? <small>{item.date}</small> : null}</p>
            </div>
          );
        })}
      </div>
    ) : null}
    <div class="viz-grid">
      {visuals.map((visual, visualIndex) => {
        const source = visual.source;
        const sourceText = sourceLabel(source);
        const fileName = fileSafe(visual.title);
        const chartId = `viz-${fileName}-${visualIndex + 1}`;
        const note = chartNotes[visualIndex];
        const narrow = leftoverGrid && !fullRow[visualIndex];
        const base = cardClass(visualIndex, visual, leadFirst) + (leftoverGrid && fullRow[visualIndex] ? " viz-span" : "");
        const card = {
          title: visual.title,
          subtitle: cleanSubtitle(visual.subtitle || "", source.sourceId),
          unit: visual.kind === "pyramid" ? (visual as PyramidVisual).year : visual.unit,
          chartId,
          fileName,
          csvUrl: `${chartDownloadBase}/${fileName}.csv`,
          note,
          sourceText,
          sourceUrl: source.sourceUrl
        };
        if (visual.kind === "almanac") {
          return (
            <FigureCard cls={`${base} alm-card alm-${visual.form}`} {...card} figNote={visual.stat}>
              <Fragment set:html={typeset(visual.svg)} />
              <Fragment set:html={typeset(visual.svgM)} />
            </FigureCard>
          );
        }
        if (visual.kind === "line") {
          const size = (visual as { size?: string }).size;
          const isLead = size === "hero" || (leadFirst && visualIndex === 0 && !size);
          // Use the large geometry only for big cards (hero / feature). A small
          // multi-line card must NOT use the 1160-wide geometry, or its axis text
          // downscales far smaller than the single-line small charts beside it.
          const isLarge = isLead || size === "feature" || (visualIndex === 0 && leadFirst && !size && visual.lines.length > 1);
          const g = lineGeometry(visual as LineVisual, isLarge, narrow);
          const gm = lineGeometry(visual as LineVisual, isLarge, narrow, undefined, true);
          const mention = [visual.title, card.subtitle, note?.takeaway].join(" ");
          return (
            <FigureCard cls={base} {...card}>
              <Fragment set:html={typeset(renderLineSvg(visual as LineVisual, g, { isLead, mobile: false, chartId, cls: isLead ? "viz-svg viz-svg-lead viz-d alm-line" : "viz-svg viz-d alm-line", mention }))} />
              <Fragment set:html={typeset(renderLineSvg(visual as LineVisual, gm, { isLead, mobile: true, chartId, cls: isLead ? "viz-svg viz-svg-lead viz-m alm-line" : "viz-svg viz-m alm-line", mention }))} />
              {visual.lines.length > 1 && (
                // Desktop names each line at its end; phones show values only, so the key
                // appears there, and on desktop only when there are too many lines to label.
                // Two keys, one per drawing: each carries the values its own drawing moved off
                // the line ends, in the order those lines end.
                [{ geo: gm, cls: "viz-legend-m" }, { geo: g, cls: visual.lines.length > 7 || g.keyValues ? "viz-legend-d" : "" }].filter((k) => k.cls).map(({ geo, cls }) => (
                  <div class={`viz-legend ${cls}${geo.keyValues ? " viz-legend-kv" : ""}`}>
                    {(geo.keyOrder ?? visual.lines.map((_, index) => index)).map((index) => <span><i style={`background:${lineInks(visual.lines)[index].color}`}></i>{visual.lines[index].label}{geo.keyValues?.[index] && <b class="kv">{geo.keyValues[index]}</b>}</span>)}
                  </div>
                ))
              )}
            </FigureCard>
          );
        }
        if (visual.kind === "stripes") {
          const stripes = visual as StripeVisual;
          const spread = Math.max(Math.abs(stripes.max - stripes.center), Math.abs(stripes.center - stripes.min)) || 1;
          const isRain = /rain|monsoon|precip|departure/i.test(`${stripes.title} ${stripes.unit}`);
          const lowLabel = isRain ? "Drier" : "Cooler";
          const highLabel = isRain ? "Wetter" : "Hotter";
          // Rain runs dry haldi to wet hara; everything else (temperature) cool neel to hot
          // sindoor. Both centre on the series' own normal with a grey middle, and both arms
          // span the same distance so equal departures get equal colour.
          const stripeStops: AlmStops = isRain
            ? ALM_SCALES.rain.map(([v, c]) => [stripes.center + (v / 22) * spread, c] as [number, string])
            : ([[-1, "#24387f"], [-0.6, "#6a7bc0"], [-0.25, "#c9d0ea"], [0, "#ededed"], [0.25, "#f1cbba"], [0.6, "#cc6849"], [1, "#7a2816"]] as AlmStops).map(([v, c]) => [stripes.center + v * spread, c] as [number, string]);
          // A stripe's tooltip prints the published value. Only an absolute rain series
          // (mm, not a departure) is written as its distance from the normal, and says so.
          const stripeFmt = (v: number) => {
            if (!isRain) return fmt(v, stripes.unit);
            const d = stripes.center === 0 ? v : v - stripes.center, t = fmt(Math.abs(d), stripes.unit);
            return `${d > 0 ? "+" : d < 0 ? "−" : ""}${t}${stripes.center === 0 ? "" : " vs normal"}`;
          };
          const stripeYears = stripes.stripes.map((st) => ({ year: Number(String(st.date).slice(0, 4)), value: st.value }));
          return (
            <FigureCard cls={base} {...card}>
              <Fragment set:html={typeset(almStripes(stripeYears, { stops: stripeStops, width: narrow ? 508 : 1040, height: 210, valueFmt: stripeFmt, label: stripes.title }).replace('class="viz-svg alm"', 'class="viz-svg viz-d alm"'))} />
              <Fragment set:html={typeset(almStripes(stripeYears, { stops: stripeStops, width: 346, height: 170, compact: true, valueFmt: stripeFmt, label: stripes.title }).replace('class="viz-svg alm"', 'class="viz-svg viz-m alm"'))} />
              <div class="alm-stripe-key">
                <Fragment set:html={typeset(almScaleKey(stripeStops, [[stripeStops[0][0], lowLabel], [stripes.center, "Normal"], [stripeStops[stripeStops.length - 1][0], highLabel]], 300))} />
              </div>
            </FigureCard>
          );
        }
        if (visual.kind === "choropleth") {
          const cho = visual as ChoroplethVisual;
          const valued = cho.regions.filter((r) => r.value !== null && r.value !== undefined);
          const noDataNames = cho.regions.filter((r) => r.value === null || r.value === undefined).map((r) => r.name);
          const svgUrl = `${chartDownloadBase}/${fileName}.svg`;
          // In `astro dev` the static [chart].svg.ts endpoint is not generated, so the
          // lazy/noscript map URL 404s and the map renders blank. Inline the SVG in dev
          // so maps are previewable; keep lazy-loading in production builds for weight.
          const lazyMap = !import.meta.env.DEV && (visualIndex > 0 || !leadFirst);
          return (
            <FigureCard cls={base} {...card} svgUrl={svgUrl}>
              <div class="choro-wrap">
                {lazyMap ? (
                  <>
                    <div class="lazy-svg-frame choro-map-frame" data-lazy-svg={svgUrl} aria-label={cho.title} style={`aspect-ratio:${viewBoxAspectRatio(cho.viewBox)}`}></div>
                    <noscript><img class="viz-svg choro-map" src={svgUrl} alt={cho.title} loading="lazy" /></noscript>
                  </>
                ) : <Fragment set:html={typeset(renderChoroplethSvg(cho))} />}
                <div class="choro-side">
                  <Fragment set:html={typeset(renderChoroplethStrip(cho))} />
                  {cho.regions.length > valued.length ? <span class="choro-nodata"><i></i>Outlined: not surveyed</span> : null}
                </div>
              </div>
              {noDataNames.length ? (
                <p class="choro-foot">Outlined states ({noDataNames.join(", ")}) were not covered by the survey sample, so no estimate exists for them. They are left uncoloured rather than counted as zero.</p>
              ) : null}
            </FigureCard>
          );
        }
        const fig = renderFigure(visual, { narrow, chartId });
        if (!fig) return null;
        return (
          <FigureCard cls={`${base} alm-card fig-card fig-${visual.kind}`} {...card} figNote={fig.note}>
            <Fragment set:html={typeset(fig.svg)} />
            <Fragment set:html={typeset(fig.svgM)} />
          </FigureCard>
        );
      })}
    </div>
  </section>
) : null}

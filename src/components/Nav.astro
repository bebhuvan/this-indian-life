---
// The masthead: the wordmark, the six chapters, the contents and search, then the double
// rule. The home page sets the name as a nameplate over the bar, under a kicker with the
// tagline and the size of the book. On phones the chapters fold into a sheet.
import { domains } from "../data/site";
import { chapters } from "../data/book";

type Props = { active?: string; locale?: string; nameplate?: boolean };
const { active, nameplate = false } = Astro.props;
const reference = [
  { id: "articles", label: "Contents", href: "/articles/" },
  { id: "academy", label: "Academy", href: "/academy/" },
  { id: "about", label: "About", href: "/about/" },
];
const count = (id: string) => chapters.find((c) => c.id === id)?.entries.length ?? 0;
const total = chapters.reduce((n, c) => n + c.entries.length, 0);
---

<header class:list={["tl-mast", { "is-np": nameplate }]}>
  {nameplate ? (
    <>
      <div class="tl-kick"><span>India, one number at a time</span><span>{total} questions in {domains.length} chapters</span></div>
      <div class="tl-dr" aria-hidden="true"></div>
      <a class="tl-np" href="/" aria-label="This Indian Life, home">This <em>Indian</em> Life<b aria-hidden="true">.</b></a>
    </>
  ) : null}
  <div class="bar">
    <a class="tl-wm" href="/" aria-label="This Indian Life, home">This <em>Indian</em> Life<b aria-hidden="true">.</b></a>
    <nav class="tl-nav" aria-label="Chapters">
      {domains.map((d) => <a href={`/${d.id}/`} aria-current={active === d.id ? "page" : undefined}>{d.label}</a>)}
    </nav>
    <div class="tl-tools">
      <a href="/articles/" aria-current={active === "articles" ? "page" : undefined}>Contents</a>
      <a class="srch" href="/articles/#find">Search</a>
      <details class="tl-menu">
        <summary aria-label="Open the chapters">Chapters</summary>
        <div class="tl-sheet">
          {domains.map((d) => <a href={`/${d.id}/`} aria-current={active === d.id ? "page" : undefined}>{d.label}<span>{count(d.id)} questions</span></a>)}
          {reference.map((r) => <a class="ref" href={r.href}>{r.label}</a>)}
        </div>
      </details>
    </div>
  </div>
  <div class="tl-dr" aria-hidden="true"></div>
</header>
<script is:inline>
  // The phone sheet closes on Escape or a tap outside it.
  (() => {
    const m = document.querySelector(".tl-menu");
    if (!m) return;
    document.addEventListener("click", (e) => { if (m.open && !m.contains(e.target)) m.open = false; });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && m.open) { m.open = false; m.querySelector("summary")?.focus(); } });
  })();
</script>

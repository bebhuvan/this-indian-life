---
import { domains } from "../data/site";

type Props = {
  active?: string;
  locale?: string;
};

const { active, locale = "en" } = Astro.props;
const reference = [
  { id: "academy", label: "Academy", href: "/academy/" },
  { id: "articles", label: "Articles", href: "/articles/" },
  { id: "about", label: "About", href: "/about/" }
];
const current = domains.find((d) => d.id === active)?.label ?? reference.find((r) => r.id === active)?.label;
---

<nav class="nav">
  <a class="brand" href="/">This Indian Life</a>
  <div class="domains">
    {domains.map((domain) => (
      <a
        data-d={domain.id}
        class={active === domain.id ? "on" : ""}
        href={`/${domain.id}/`}
      >
        {domain.label}
      </a>
    ))}
    {reference.map((r) => <a data-d="reference" class={active === r.id ? "on" : ""} href={r.href}>{r.label}</a>)}
  </div>
  {/* Phones: one line, the brand and a menu that names the section you are in. */}
  <details class="nav-menu">
    <summary aria-label="Sections">
      {current ? <span class="nm-here" data-d={active}>{current}</span> : null}
      <span class="nm-btn">Sections<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    </summary>
    <div class="nm-panel">
      <ul class="nm-topics">
        {domains.map((domain) => (
          <li><a data-d={domain.id} class={active === domain.id ? "on" : ""} href={`/${domain.id}/`}><i></i>{domain.label}</a></li>
        ))}
      </ul>
      <ul class="nm-ref">
        {reference.map((r) => <li><a class={active === r.id ? "on" : ""} href={r.href}>{r.label}</a></li>)}
      </ul>
    </div>
  </details>
</nav>
<hr class="r" />
<script is:inline>
  // The phone menu closes on Escape or a tap outside it.
  (() => {
    const m = document.querySelector(".nav-menu");
    if (!m) return;
    document.addEventListener("click", (e) => { if (m.open && !m.contains(e.target)) m.open = false; });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && m.open) { m.open = false; m.querySelector("summary")?.focus(); } });
  })();
</script>

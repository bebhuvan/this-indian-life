---
// "Cite this article" block for the foot of an article. The site is CC BY 4.0,
// so attribution is the license condition — this turns "you must attribute" into
// "copy this". Plain citation is the default (covers most reuse); BibTeX/APA sit
// behind disclosures for the academic crowd. Pure static HTML + a tiny copy script.
import { SITE } from "../data/seo";
import { gitMetaFor, questionUrl } from "../data/questions";
import type { QuestionPage, ExplanationArtifact } from "../data/questions";

type Props = { page: QuestionPage; explanation: ExplanationArtifact };
const { page, explanation } = Astro.props;

const title = page.question;
const author = SITE.author.name;       // "Bhuvanesh"
const publisher = SITE.name;           // "This Indian Life"
const url = `${SITE.url}${questionUrl(page)}`;

// Cite the version published on its commit date (distinct from the data-coverage
// date the evidence block shows). Fall back to the generation date, then build year.
const gmeta = gitMetaFor(page.id);
const pub = gmeta.updated || explanation.generatedAt || null;
const d = pub ? new Date(pub) : null;
const year = d && !Number.isNaN(d.getTime()) ? d.getFullYear() : new Date().getFullYear();
const monthYear = d && !Number.isNaN(d.getTime())
  ? d.toLocaleDateString("en-GB", { month: "long", year: "numeric" })
  : String(year);

// Titles that already end in terminal punctuation ("...economy?") must not get a
// second period ("...economy?."). Keep their own mark; add a period otherwise.
const endsPunct = /[?!.]$/.test(title);
const plain = `${author}. ${endsPunct ? `“${title}”` : `“${title}.”`} ${publisher}, ${monthYear}. ${url}`;
const apa = `${author}. (${year}). ${endsPunct ? title : `${title}.`} ${publisher}. ${url}`;
const bibKey = `tilife-${page.slug.replace(/[^a-z0-9]+/gi, "")}`;
const bibtex = `@misc{${bibKey},
  author    = {${author}},
  title     = {${title}},
  year      = {${year}},
  publisher = {${publisher}},
  url       = {${url}}
}`;
---

<div class="cite">
  <div class="cite-head">
    <span class="cite-lbl">Cite this article</span>
    <a class="cite-lic" href="/license/">CC BY 4.0, free to reuse with credit</a>
  </div>

  <div class="cite-main">
    <p class="cite-text" id="cite-plain">{plain}</p>
    <button class="cite-copy" data-copy="#cite-plain" type="button" aria-label="Copy citation">Copy</button>
  </div>

  <div class="cite-formats">
    <details class="cite-det">
      <summary>BibTeX</summary>
      <div class="cite-block">
        <pre id="cite-bibtex">{bibtex}</pre>
        <button class="cite-copy sm" data-copy="#cite-bibtex" type="button" aria-label="Copy BibTeX">Copy</button>
      </div>
    </details>
    <details class="cite-det">
      <summary>APA</summary>
      <div class="cite-block">
        <p id="cite-apa">{apa}</p>
        <button class="cite-copy sm" data-copy="#cite-apa" type="button" aria-label="Copy APA citation">Copy</button>
      </div>
    </details>
  </div>
</div>

<style>
  /* Almanac end matter: ruled, unboxed; the citation is set like a reference in a book. */
  .cite{max-width:660px;border-top:2px solid var(--ink);padding-top:14px}
  .cite-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:16px}
  .cite-lbl{font-family:var(--sans);font-size:.72rem;letter-spacing:.09em;text-transform:uppercase;font-weight:600;color:var(--ink)}
  .cite-lic{font-family:var(--sans);font-size:.82rem;color:var(--mid);text-decoration:underline;text-decoration-color:#cfcfcf;text-underline-offset:3px}
  .cite-lic:hover{color:var(--c-ink);text-decoration-color:var(--c)}
  .cite-main{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:baseline;border-left:2px solid var(--c);padding:2px 0 2px 16px}
  .cite-text{margin:0;font-family:var(--serif);font-size:1.08rem;line-height:1.55;color:var(--ink);overflow-wrap:anywhere}
  .cite-copy{cursor:pointer;font-family:var(--sans);font-size:.82rem;font-weight:500;color:var(--ink);background:none;border:0;border-bottom:1.5px solid var(--ink);border-radius:0;padding:0 0 2px;white-space:nowrap}
  .cite-copy:hover,.cite-copy.is-done{color:var(--c-ink);border-color:var(--c)}
  .cite-formats{display:flex;gap:24px;margin-top:18px;flex-wrap:wrap}
  .cite-det{flex:1 1 100%}
  .cite-det summary{cursor:pointer;display:inline-block;font-family:var(--sans);font-size:.82rem;font-weight:500;color:var(--mid);list-style:none}
  .cite-det summary:hover{color:var(--ink)}
  .cite-det summary::-webkit-details-marker{display:none}
  .cite-det summary::before{content:"+";display:inline-block;width:1em;color:var(--dim)}
  .cite-det[open] summary::before{content:"\2212"}
  .cite-block{position:relative;margin-top:10px;border-top:1px solid var(--rule);padding-top:12px}
  .cite-block pre,.cite-block p{margin:0;line-height:1.55;color:var(--ink)}
  .cite-block pre{font-size:.8rem;overflow-x:auto;white-space:pre;padding-right:70px}
  .cite-block p{font-family:var(--serif);font-size:1rem;padding-right:70px}
  .cite-block .cite-copy{position:absolute;top:12px;right:0}
  @media(max-width:620px){.cite-main{grid-template-columns:1fr;gap:10px}.cite-main .cite-copy{justify-self:start}.cite-block p,.cite-block pre{padding-right:0}.cite-block .cite-copy{position:static;margin-top:10px}}
</style>

<script>
  document.querySelectorAll(".cite-copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const sel = btn.getAttribute("data-copy");
      const el = sel ? document.querySelector(sel) : null;
      if (!el || !el.textContent) return;
      try {
        await navigator.clipboard.writeText(el.textContent.trim());
        const prev = btn.textContent;
        btn.textContent = "Copied";
        btn.classList.add("is-done");
        setTimeout(() => { btn.textContent = prev; btn.classList.remove("is-done"); }, 1600);
      } catch (e) { /* clipboard blocked; no-op */ }
    });
  });
</script>
